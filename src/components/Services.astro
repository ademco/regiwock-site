---
import SectionHead from './SectionHead.astro';
import { SERVICES } from '../config';
---

<section id="services" class="px-4 py-20 sm:px-8 sm:py-28" aria-labelledby="services-title">
  <SectionHead id="services-title" index="05" title="Book me for" kicker="What you get" />

  <div class="grid gap-px border border-line bg-line md:grid-cols-3">
    {
      SERVICES.map((s, i) => (
        <article class="group relative flex flex-col bg-bg p-6 sm:p-8" data-reveal style={`--d:${i * 90}ms`}>
          <span class="vf vf-hover text-accent" aria-hidden="true"><i /><i /><i /><i /></span>
          <p class="label mb-6 text-muted">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="display mb-6 text-4xl sm:text-5xl">{s.title}</h3>
          <ul class="mb-8 flex-1 space-y-2.5">
            {s.points.map((p) => (
              <li class="flex gap-3 leading-snug">
                <span class="accent-text mt-[0.1em] shrink-0">+</span>
                {p}
              </li>
            ))}
          </ul>
          <a href="#book" data-inquiry={s.inquiry} class="btn self-start">
            Book {s.title.toLowerCase()} <span class="arrow">→</span>
          </a>
        </article>
      ))
    }
  </div>
</section>
