---
import SectionHead from './SectionHead.astro';
import Media from './Media.astro';
import { getWork } from '../lib/work';

const items = await getWork();
const filters = [
  { key: 'all', label: 'All' },
  { key: 'stream', label: 'Streams' },
  { key: 'music', label: 'Music' },
  { key: 'post', label: 'Posts' },
  { key: 'drop', label: 'Drops' },
] as const;
const count = (k: string) => (k === 'all' ? items.length : items.filter((i) => i.type === k).length);
const typeLabel = { stream: 'Stream', music: 'Music', post: 'Post', drop: 'Drop' } as const;
---

<section id="work" class="px-4 py-20 sm:px-8 sm:py-28" aria-labelledby="work-title">
  <SectionHead id="work-title" index="01" title="The Work" kicker="Streams, music, posts, drops" />

  <div class="-mx-4 mb-8 overflow-x-auto px-4 sm:mx-0 sm:px-0" data-reveal>
    <div class="flex w-max gap-2" role="toolbar" aria-label="Filter work">
      {
        filters.map((f, i) => (
          <button
            type="button"
            class="filter label flex h-10 items-center gap-2 border border-line px-4 transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-bg"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {f.label}
            <span class="opacity-60">{count(f.key)}</span>
          </button>
        ))
      }
    </div>
  </div>

  <ul id="work-grid" class="grid grid-flow-dense grid-cols-1 gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      items.map((item, i) => (
        <li
          class:list={['work-card', item.featured && 'sm:col-span-2 lg:row-span-2']}
          data-type={item.type}
          data-reveal
          style={`--d:${(i % 3) * 80}ms`}
        >
          <Media media={item.media} title={item.title} />
          <div class="mt-3 flex items-start justify-between gap-4">
            <div>
              <p class="label mb-1.5 flex items-center gap-2 text-muted">
                <span class="bg-ink px-1.5 py-0.5 text-bg">
                  {typeLabel[item.type]}
                </span>
                {item.media.platformLabel}
                {item.featured && <span class="accent-text">★ Featured</span>}
              </p>
              <h3 class:list={['leading-tight font-medium tracking-tight', item.featured ? 'text-2xl' : 'text-xl']}>{item.title}</h3>
              {item.note && <p class="mt-1 text-sm text-muted">{item.note}</p>}
            </div>
            <a
              href={item.url}
              target="_blank"
              rel="noopener"
              class="label mt-1 shrink-0 text-muted transition-colors hover:text-ink"
              aria-label={`Open ${item.title} on ${item.media.platformLabel}`}
            >
              ↗
            </a>
          </div>
        </li>
      ))
    }
  </ul>

  <div id="work-empty" class="hidden border border-dashed border-line px-6 py-16 text-center" aria-live="polite">
    <p class="display text-4xl sm:text-5xl">Cooking.</p>
    <p class="label mt-3 text-muted">Nothing here yet — first one drops soon. Follow @regiwock.</p>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('.work-card');
  const empty = document.getElementById('work-empty')!;

  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter!;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      let shown = 0;
      cards.forEach((c) => {
        const show = f === 'all' || c.dataset.type === f;
        c.hidden = !show;
        c.classList.remove('pop');
        if (show) {
          shown++;
          c.classList.add('in');
          void c.offsetWidth; // restart the stop-motion pop
          c.classList.add('pop');
        }
      });
      empty.classList.toggle('hidden', shown > 0);
    }),
  );
</script>
