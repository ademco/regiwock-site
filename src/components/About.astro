---
import SectionHead from './SectionHead.astro';
import { ABOUT } from '../config';
---

<section id="about" class="px-4 py-20 sm:px-8 sm:py-28" aria-labelledby="about-title">
  <SectionHead id="about-title" index="03" title="About" kicker="Regi, @regiwock" />

  <div class="grid gap-10 lg:grid-cols-12">
    <p class="display text-4xl sm:text-6xl lg:col-span-7" data-reveal>
      {ABOUT[0]}
    </p>
    <div class="space-y-5 text-lg leading-relaxed text-muted lg:col-span-5 lg:pt-3">
      {ABOUT.slice(1).map((p, i) => <p data-reveal style={`--d:${(i + 1) * 90}ms`}>{p}</p>)}
    </div>
  </div>
</section>
