---
import Base from '../layouts/Base.astro';
---

<Base title="Lost signal — Regiwock">
  <main class="flex min-h-svh flex-col items-start justify-center gap-6 px-4 sm:px-8">
    <p class="label text-muted"><span class="rec-dot mr-2"></span>No signal · 404</p>
    <h1 class="display text-7xl sm:text-9xl">Lost the feed<span class="accent-text">.</span></h1>
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn btn-lg">Back home</a>
      <a href="/#book" class="btn btn-accent btn-lg">Book me <span class="arrow">→</span></a>
    </div>
  </main>
</Base>
