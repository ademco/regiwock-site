---
// Roadmap 2.1 — three look directions side by side so Regi can pick one (or a mix).
// Hidden page: not linked anywhere, noindex. Each direction is scoped by its own
// CSS variables on `.dir-*`, so the markup is identical and only the skin changes.
import '@fontsource/inter-tight/latin-600.css';
import '@fontsource/doto/latin-900.css';
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import Base from '../layouts/Base.astro';
import { PROFILE, COLLABS } from '../config';
import { detect } from '../lib/platforms.mjs';

const sample = COLLABS[0];
const thumb = detect(sample.url).thumbnail;

const directions = [
  {
    key: 'notebook',
    name: 'Notebook',
    vibe: 'Pencil on ruled paper. Handmade, a little rough, rainbow only where you should tap.',
    swatches: [
      { name: 'Paper', hex: '#FBFAF6' },
      { name: 'Graphite', hex: '#1D1D1B' },
      { name: 'Pencil', hex: '#6D6B66' },
      { name: 'Rule blue', hex: '#CDDCF0' },
      { name: 'Margin red', hex: '#F0A7A7' },
      { name: 'Rainbow', hex: 'Book me only', fill: 'linear-gradient(90deg,#ff2e63,#ff9f1c,#ffe600,#25e07a,#2ea8ff,#8a2eff)' },
    ],
    type: ['Unbounded 800 · caps', 'Unbounded 800 · caps', 'Inter Tight 400', 'JetBrains Mono · caps', 'Caveat · notes'],
    motion: 'Stop-motion at 12fps: things boil, pop and wobble in steps instead of gliding. Charming, but busy if overused.',
  },
  {
    key: 'stark',
    name: 'Stark',
    vibe: 'White space, black type, one blue. Nothing extra, so every animation feels deliberate.',
    swatches: [
      { name: 'White', hex: '#FFFFFF' },
      { name: 'Mist', hex: '#F5F5F7' },
      { name: 'Black', hex: '#0A0A0A' },
      { name: 'Gray', hex: '#6E6E73' },
      { name: 'Cobalt', hex: '#2340FF' },
    ],
    type: ['Inter Tight 600', 'Inter Tight 600', 'Inter Tight 400', 'Inter Tight 500 · caps'],
    motion: 'Smooth and quick: text slides up out of a mask, fills sweep, images ease. One motion language that scales to page transitions, scroll reveals and a hero reel.',
  },
  {
    key: 'broadcast',
    name: 'Broadcast',
    vibe: 'The control room. Dark panels, a live timecode, tally-light red, focus brackets. It feels like the tech Regi actually runs.',
    swatches: [
      { name: 'Studio', hex: '#0B0C0D' },
      { name: 'Panel', hex: '#15171A' },
      { name: 'Signal', hex: '#EEF0EC' },
      { name: 'Steel', hex: '#8B9096' },
      { name: 'Tally red', hex: '#FF3B2F' },
      { name: 'Preview green', hex: '#3DDC84' },
    ],
    type: ['Doto 900 · dot matrix', 'Geist Sans 600', 'Geist Sans 400', 'Geist Mono · caps'],
    motion: 'Snap cuts like switching cameras: sections flicker on, focus brackets lock onto what you touch, the REC light blinks and the timecode always runs.',
  },
] as const;

const roles = PROFILE.roles.join(' · ');
---

<Base title={`Style guide — ${PROFILE.wordmark}`} description="Three look directions for regiwock.com." noindex>
  <header class="sg-top">
    <div class="sg-intro">
      <p class="sg-kicker">{PROFILE.wordmark} · Style guide · Round 1 of 3</p>
      <h1 class="sg-title">Pick a look.</h1>
      <p class="sg-text">
        Same content, three skins. Tap the buttons and the card to see the motion. Reply with <b>1</b>, <b>2</b>, <b>3</b>, or a mix
        (like “2’s layout with 3’s colors”).
      </p>
    </div>
  </header>
  <nav class="sg-tabs" aria-label="Directions">
      {directions.map((d, i) => (
        <button type="button" data-tab={i} aria-current={i === 0 ? 'true' : undefined}>
          <span>{i + 1}</span> {d.name}
        </button>
      ))}
  </nav>

  <main class="track" data-track>
    {
      directions.map((d, i) => (
        <section class={`dir dir-${d.key}`} id={d.key} data-dir aria-labelledby={`${d.key}-name`}>
          <header class="dir-head enter" style="--i:0">
            <p class="label">
              Direction {i + 1}
              {d.key === 'broadcast' && (
                <span class="rec">
                  <i /> REC <span data-tc>00:00:00:00</span>
                </span>
              )}
            </p>
            <h2 id={`${d.key}-name`} class="dir-name">{d.name}</h2>
            <p class="dir-vibe">{d.vibe}</p>
          </header>

          {/* Hero sample */}
          <div class="block">
            <p class="label block-label">Hero sample</p>
            <div class="hero">
              <div class="hero-bar enter" style="--i:1">
                <span class="hero-mark">{PROFILE.wordmark}</span>
                <span class="label">Work ↗</span>
              </div>
              <p class="hero-pitch" aria-label={PROFILE.pitch}>
                <span class="line enter" style="--i:2"><span>The glue</span></span>
                <span class="line enter" style="--i:3"><span>since 1999.</span></span>
              </p>
              <p class="label hero-roles enter" style="--i:4">{roles}</p>
              <div class="enter" style="--i:5">
                <button type="button" class="b b-primary">
                  <span class="bk" aria-hidden="true"><i /><i /><i /><i /></span>
                  Book me <span class="arr" aria-hidden="true">→</span>
                </button>
              </div>
              {d.key === 'notebook' && <p class="hand hero-note enter" style="--i:6">fig. 1 — regi, falling up</p>}
            </div>
            <button type="button" class="replay label" data-replay>↻ Replay motion</button>
          </div>

          {/* Colors */}
          <div class="block">
            <p class="label block-label">Colors</p>
            <ul class="swatches">
              {d.swatches.map((s) => (
                <li>
                  <span class="chip" style={`background:${'fill' in s ? s.fill : s.hex}`} />
                  <span class="sw-name">{s.name}</span>
                  <span class="label sw-hex">{s.hex}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Type */}
          <div class="block">
            <p class="label block-label">Type</p>
            <div class="type">
              <p class="label t-meta">Display · {d.type[0]}</p>
              <p class="t-display">Book me.</p>
              <p class="label t-meta">Heading · {d.type[1]}</p>
              <p class="t-h">Stream production</p>
              <p class="label t-meta">Body · {d.type[2]}</p>
              <p class="t-body">I like putting smart, creative people from different worlds in the same room and giving everyone a voice.</p>
              <p class="label t-meta">Label · {d.type[3]}</p>
              <p class="label t-label">Camera · Tech setup · Live</p>
              {d.type[4] && (
                <>
                  <p class="label t-meta">Note · {d.type[4]}</p>
                  <p class="hand t-hand">this one's my favorite →</p>
                </>
              )}
            </div>
          </div>

          {/* Buttons */}
          <div class="block">
            <p class="label block-label">Buttons</p>
            <div class="btn-grid">
              <div>
                <p class="label t-meta">Primary</p>
                <button type="button" class="b b-primary">
                  <span class="bk" aria-hidden="true"><i /><i /><i /><i /></span>
                  Book me <span class="arr" aria-hidden="true">→</span>
                </button>
              </div>
              <div>
                <p class="label t-meta">Secondary</p>
                <button type="button" class="b b-secondary">
                  <span class="bk" aria-hidden="true"><i /><i /><i /><i /></span>
                  See work
                </button>
              </div>
              <div aria-hidden="true">
                <p class="label t-meta">Primary · hover</p>
                <span class="b b-primary is-hover">
                  <span class="bk"><i /><i /><i /><i /></span>
                  Book me <span class="arr">→</span>
                </span>
              </div>
              <div aria-hidden="true">
                <p class="label t-meta">Secondary · hover</p>
                <span class="b b-secondary is-hover">
                  <span class="bk"><i /><i /><i /><i /></span>
                  See work
                </span>
              </div>
            </div>
          </div>

          {/* Card */}
          <div class="block">
            <p class="label block-label">Work card · tap it</p>
            <article class="card" tabindex="0" data-card>
              <div class="card-media">
                {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
                {d.key === 'broadcast' && (
                  <span class="cam" aria-hidden="true">
                    <i /><i /><i /><i />
                    <span class="label cam-rec"><b /> REC</span>
                    <span class="label cam-id">CAM 1</span>
                    <span class="label cam-tc" data-tc>00:00:00:00</span>
                  </span>
                )}
                {d.key === 'notebook' && <span class="hand card-note" aria-hidden="true">← tap to play</span>}
              </div>
              <div class="card-body">
                <div>
                  <p class="label card-tags"><span class="tag">Stream</span> YouTube</p>
                  <h3 class="card-title">{sample.name}</h3>
                  <p class="card-line">{sample.roles.join(' · ')}</p>
                </div>
                <span class="card-go" aria-hidden="true">→</span>
              </div>
            </article>
          </div>

          {/* Motion */}
          <div class="block">
            <p class="label block-label">Motion</p>
            <p class="motion">{d.motion}</p>
          </div>
        </section>
      ))
    }
  </main>
</Base>

<script>
  const track = document.querySelector<HTMLElement>('[data-track]')!;
  const panels = [...document.querySelectorAll<HTMLElement>('[data-dir]')];
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Phone: tabs swipe the track. Desktop shows all three, so tabs are hidden.
  tabs.forEach((tab, i) =>
    tab.addEventListener('click', () => {
      track.scrollTo({ left: panels[i].offsetLeft, behavior: reduce ? 'auto' : 'smooth' });
      if (track.getBoundingClientRect().top < 0) track.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    }),
  );
  let raf = 0;
  track.addEventListener('scroll', () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(() => {
      const current = Math.round(track.scrollLeft / track.clientWidth);
      tabs.forEach((t, i) => (i === current ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    });
  });

  // Entrance motion plays when a direction comes into view; "Replay" restarts it.
  const play = (panel: HTMLElement) => {
    panel.classList.remove('play');
    void panel.offsetWidth;
    panel.classList.add('play');
  };
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && (play(e.target as HTMLElement), io.unobserve(e.target))),
    { threshold: 0.2 },
  );
  panels.forEach((p) => io.observe(p));
  document.querySelectorAll<HTMLElement>('[data-replay]').forEach((b) => b.addEventListener('click', () => play(b.closest('[data-dir]')!)));

  // Phones can't hover: tapping the card toggles its hover state.
  document.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => c.addEventListener('click', () => c.classList.toggle('is-on')));

  // Broadcast: running timecode (HH:MM:SS:FF at 30fps).
  const tcs = document.querySelectorAll<HTMLElement>('[data-tc]');
  if (tcs.length && !reduce) {
    const t0 = performance.now();
    let last = -1;
    const tick = (now: number) => {
      const f = Math.floor(((now - t0) / 1000) * 30);
      if (f !== last) {
        last = f;
        const tc = [Math.floor(f / 108000), Math.floor(f / 1800) % 60, Math.floor(f / 30) % 60, f % 30]
          .map((n) => String(n).padStart(2, '0'))
          .join(':');
        tcs.forEach((el) => (el.textContent = tc));
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>

<style>
  /* No paper grain on this page: it would sit on top of all three directions. */
  :global(body::after) { display: none; }
  :global(body) { background: #e9e9e5; }

  /* ---------- Page chrome (neutral, so it doesn't favor a direction) ---------- */
  .sg-top { background: #e9e9e5; color: #111; font-family: "Inter Tight", system-ui, sans-serif; }
  .sg-intro { padding: 28px 16px 20px; max-width: 46rem; }
  .sg-kicker { font: 500 12px/1.4 "JetBrains Mono", ui-monospace, monospace; letter-spacing: 0.06em; text-transform: uppercase; color: #555; }
  .sg-title { margin-top: 10px; font-size: 40px; font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
  .sg-text { margin-top: 12px; font-size: 16px; line-height: 1.5; color: #333; }
  .sg-tabs {
    position: sticky; top: 0; z-index: 30;
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;
    padding: 8px 16px; background: rgb(233 233 229 / 0.92); backdrop-filter: blur(8px);
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }
  .sg-tabs button {
    min-height: 44px; border-radius: 10px; font: 500 14px/1 "Inter Tight", system-ui, sans-serif; color: #333;
    background: transparent; transition: background-color 0.2s, color 0.2s;
  }
  .sg-tabs button span { font-family: "JetBrains Mono", monospace; font-size: 12px; opacity: 0.6; margin-right: 2px; }
  .sg-tabs button[aria-current] { background: #111; color: #fff; }

  /* ---------- Track: swipe on phones, three columns on desktop ---------- */
  .track {
    position: relative;
    display: flex; align-items: flex-start;
    overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .dir { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; scroll-snap-stop: always; }
  @media (min-width: 1024px) {
    .sg-intro { padding: 40px 32px 32px; }
    .sg-title { font-size: 56px; }
    .sg-tabs { display: none; }
    .track { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: stretch; overflow: visible; }
  }

  /* ---------- Shared structure (skins come below) ---------- */
  .dir {
    background: var(--bg); color: var(--ink); font-family: var(--fb);
    padding: 28px 16px 56px; min-height: 100svh;
  }
  @media (min-width: 1024px) { .dir { padding: 36px 28px 72px; } }
  .dir .label { font-family: var(--fl); font-size: 12px; line-height: 1.4; letter-spacing: 0.06em; text-transform: uppercase; }
  .dir-head .label { color: var(--muted); display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .dir-name { margin-top: 8px; font-family: var(--fd); }
  .dir-vibe { margin-top: 10px; font-size: 16px; line-height: 1.5; color: var(--muted); max-width: 34ch; }

  .block { margin-top: 36px; }
  .block-label { color: var(--muted); padding-bottom: 10px; margin-bottom: 16px; border-bottom: 1px solid var(--line); }

  .hero { position: relative; padding: 18px; border: 1px solid var(--line); min-height: 300px; display: flex; flex-direction: column; gap: 16px; overflow: hidden; }
  .hero-bar { display: flex; justify-content: space-between; align-items: center; }
  .hero-mark { font-family: var(--fd); }
  .hero-pitch { margin-top: auto; font-family: var(--fd); }
  .line { display: block; overflow: hidden; padding-bottom: 0.1em; margin-bottom: -0.1em; }
  .line > span { display: block; }
  .hero-roles { color: var(--muted); }
  .replay { margin-top: 10px; min-height: 44px; color: var(--muted); }
  .replay:hover { color: var(--ink); }

  .swatches { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 10px; }
  .chip { display: block; aspect-ratio: 1.4; border: 1px solid var(--line); }
  .sw-name { display: block; margin-top: 8px; font-size: 14px; font-weight: 500; }
  .sw-hex { display: block; color: var(--muted); font-size: 11px; }

  .type { display: grid; gap: 6px; }
  .t-meta { color: var(--muted); margin-top: 14px; font-size: 11px !important; }
  .t-meta:first-child { margin-top: 0; }
  .t-display { font-family: var(--fd); }
  .t-body { font-size: 17px; line-height: 1.55; }
  .t-hand, .hero-note, .card-note { font-family: "Caveat", cursive; font-weight: 500; }

  .btn-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 12px; align-items: end; }
  .btn-grid .t-meta { margin-bottom: 8px; }
  .b {
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 0.5em;
    min-height: 48px; padding: 0 20px; white-space: nowrap; cursor: pointer;
  }
  .arr { display: inline-block; }
  .bk { display: none; }

  .card { display: block; cursor: pointer; outline-offset: 4px; }
  .card-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--surface); }
  .card-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .card-body { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-top: 14px; }
  .card-tags { color: var(--muted); display: flex; align-items: center; gap: 8px; }
  .card-title { margin-top: 6px; font-size: 21px; line-height: 1.15; font-weight: 600; }
  .card-line { margin-top: 4px; font-size: 15px; color: var(--muted); }
  .card-go { flex: none; display: grid; place-items: center; width: 44px; height: 44px; }
  .motion { font-size: 16px; line-height: 1.55; max-width: 40ch; }

  /* =================================================================
     1 · NOTEBOOK — current look, cleaned up
     ================================================================= */
  .dir-notebook {
    --bg: #fbfaf6; --surface: #ecebe5; --ink: #1d1d1b; --muted: #6d6b66; --line: rgb(29 29 27 / 0.16);
    --fd: "Unbounded", sans-serif; --fb: "Inter Tight", sans-serif; --fl: "JetBrains Mono", monospace;
    --rainbow: linear-gradient(90deg, #ff2e63, #ff9f1c, #ffe600, #25e07a, #2ea8ff, #8a2eff, #ff2e63);
    background:
      linear-gradient(to right, transparent 0 10px, #f0a7a7 10px 11.5px, transparent 11.5px),
      repeating-linear-gradient(to bottom, var(--bg) 0 31px, #cddcf0 31px 32px);
  }
  .dir-notebook .dir-name, .dir-notebook .hero-mark, .dir-notebook .hero-pitch, .dir-notebook .t-display, .dir-notebook .t-h {
    font-weight: 800; text-transform: uppercase; letter-spacing: -0.04em; line-height: 0.95;
  }
  .dir-notebook .dir-name { font-size: 40px; }
  .dir-notebook .hero { border: 1.5px solid var(--ink); background: rgb(251 250 246 / 0.6); }
  .dir-notebook .hero-mark { font-size: 18px; font-weight: 800; text-transform: uppercase; letter-spacing: -0.04em; }
  .dir-notebook .hero-pitch { font-size: 32px; }
  .dir-notebook .hero-note { position: absolute; right: 16px; top: 64px; font-size: 22px; color: var(--muted); transform: rotate(-4deg); }
  .dir-notebook .t-display { font-size: 38px; }
  .dir-notebook .t-h { font-size: 20px; }
  .dir-notebook .t-hand { font-size: 26px; }
  .dir-notebook .chip { border: 1.5px solid var(--ink); }
  .dir-notebook .b { border: 1.5px solid var(--ink); font-family: var(--fl); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .dir-notebook .b-primary { background: var(--rainbow); background-size: 200% 100%; animation: nb-prism 6s linear infinite; }
  .dir-notebook .b:hover, .dir-notebook .b.is-hover { background: var(--ink); color: var(--bg); }
  .dir-notebook .b:hover .arr, .dir-notebook .b.is-hover .arr { translate: 4px 0; animation: nb-jitter 0.36s steps(3) infinite; }
  .dir-notebook .card { border: 1.5px solid var(--ink); padding: 8px 8px 4px; background: var(--bg); rotate: -1.2deg; transition: rotate 0.3s steps(3), translate 0.3s steps(3); }
  .dir-notebook .card-media { outline: 1px solid var(--line); }
  .dir-notebook .card-note { position: absolute; right: 10px; bottom: 6px; font-size: 24px; color: var(--bg); background: var(--ink); padding: 0 8px; opacity: 0; transition: opacity 0.2s steps(2); }
  .dir-notebook .card:hover, .dir-notebook .card.is-on, .dir-notebook .card:focus-visible { rotate: 0deg; translate: 0 -4px; }
  .dir-notebook .card:hover .card-note, .dir-notebook .card.is-on .card-note, .dir-notebook .card:focus-visible .card-note { opacity: 1; }
  .dir-notebook .tag { background: var(--ink); color: var(--bg); padding: 2px 6px; }
  .dir-notebook .card-title { font-weight: 500; letter-spacing: -0.01em; }
  .dir-notebook .card-go { font-family: var(--fl); }
  @keyframes nb-prism { to { background-position: -200% 0; } }
  @keyframes nb-jitter { 33% { transform: translate(1px, -1px); } 66% { transform: translate(-1px, 1px); } }
  @keyframes nb-pop { from { opacity: 0; transform: translateY(10px) rotate(-2deg) scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes nb-boil { 0% { transform: translate(0, 0) rotate(0); } 33% { transform: translate(0.5px, -0.5px) rotate(-0.3deg); } 66% { transform: translate(-0.5px, 0.5px) rotate(0.3deg); } }
  @media (prefers-reduced-motion: no-preference) {
    .js .dir-notebook .enter { opacity: 0; }
    .dir-notebook.play .enter { animation: nb-pop 0.42s steps(4) both; animation-delay: calc(var(--i) * 110ms); }
    .dir-notebook.play .hero-pitch .line > span { animation: nb-boil 0.36s steps(1) infinite; }
  }

  /* =================================================================
     2 · STARK — simple, super clean, smooth motion
     ================================================================= */
  .dir-stark {
    --bg: #ffffff; --surface: #f5f5f7; --ink: #0a0a0a; --muted: #6e6e73; --line: #e6e6e8; --accent: #2340ff;
    --fd: "Inter Tight", sans-serif; --fb: "Inter Tight", sans-serif; --fl: "Inter Tight", sans-serif;
    --ease: cubic-bezier(0.2, 0.7, 0, 1);
  }
  .dir-stark .label { font-weight: 500; letter-spacing: 0.04em; }
  .dir-stark .dir-name, .dir-stark .hero-pitch, .dir-stark .t-display { font-weight: 600; letter-spacing: -0.045em; line-height: 0.95; }
  .dir-stark .dir-name { font-size: 44px; }
  .dir-stark .hero { border: 0; border-radius: 24px; background: var(--surface); padding: 20px; }
  .dir-stark .hero-mark { font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }
  .dir-stark .hero-pitch { font-size: 48px; }
  .dir-stark .t-display { font-size: 52px; }
  .dir-stark .t-h { font-size: 26px; font-weight: 600; letter-spacing: -0.025em; line-height: 1.1; }
  .dir-stark .t-body { color: #3a3a3c; }
  .dir-stark .chip { border-radius: 14px; }
