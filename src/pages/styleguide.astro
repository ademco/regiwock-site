---
// Roadmap 2.2, round 2. Regi sent the reference: a Canon EOS live view (floating white
// readouts, rule-of-thirds + diagonal grid, orange dial marks, boxed RAW/AWB/ISO labels,
// the -3..0..+3 scale) and Canon's menu (colored tabs, numbered pages, gold cursor,
// SET OK screens). The whole window is that camera screen; every readout means something real.
// Hidden page: not linked anywhere, noindex.
import '@fontsource/barlow-semi-condensed/latin-500.css';
import '@fontsource/barlow-semi-condensed/latin-600.css';
import '@fontsource/barlow-semi-condensed/latin-700.css';
import Base from '../layouts/Base.astro';
import { PROFILE, ABOUT, COLLABS, SOCIALS, EMAIL, STATS } from '../config';
import { getWork } from '../lib/work';

const work = await getWork();
const ytId = (m: { platform: string; embed: string }) =>
  m.platform === 'youtube' ? (m.embed.match(/embed\/([\w-]{11})/)?.[1] ?? '') : '';
// Camera file names: videos are MVI_####.MOV, audio SND_####.WAV, stills IMG_####.JPG.
const fileName = (type: string, n: number) => {
  const no = String(n).padStart(4, '0');
  if (type === 'stream') return `MVI_${no}.MOV`;
  if (type === 'music') return `SND_${no}.WAV`;
  return `IMG_${no}.JPG`;
};
const items = work.map((w, i) => ({
  title: w.title,
  type: w.type,
  platform: w.media.platformLabel,
  url: w.url,
  thumb: w.media.thumbnail,
  yt: ytId(w.media),
  file: fileName(w.type, i + 1),
  no: `100-${String(i + 1).padStart(4, '0')}`,
}));
// Footage = every YouTube stream on the site, featured first.
const clips = items.filter((i) => i.yt);
const first = clips[0];
const spotify = SOCIALS.find((s) => s.name === 'Spotify')!.url;
const collabs = COLLABS.map((c) => ({ ...c, clip: clips.findIndex((k) => c.url.includes(k.yt)) }));
const pad2 = (n: number) => String(n).padStart(2, '0');
// "@regiwock" from a profile URL; "Open" when the URL ends in an ID (Spotify, Apple Music).
const handle = (url: string) => {
  const seg = new URL(url).pathname.split('/').filter(Boolean).pop() ?? '';
  return /^@?[a-z][\w.]{1,20}$/i.test(seg) && !/\d{5}/.test(seg) ? (seg.startsWith('@') ? seg : `@${seg}`) : 'Open';
};
const idxPages = Math.ceil(items.length / 9);

// ---- Menu: Canon-style tabs, 6 rows per numbered page, rows can open a SET OK sub-screen ----
type Row = {
  label: string;
  value?: string;
  href?: string; // link (external when it starts with http)
  sub?: string; // opens a sub-screen
  tab?: string; // jumps to another tab
  play?: boolean; // opens SD playback
  swatch?: string; // token name, value read back from CSS
  datetime?: boolean; // the visitor's date/time
};
const tabs: { id: string; name: string; code: string; color: string; rows: Row[] }[] = [
  {
    id: 'about', name: 'About', code: 'ABOUT', color: '--tab-red',
    rows: [
      { label: 'About Regi', value: 'Read', sub: 'about' },
      { label: 'Creating since', value: STATS.creatingSince },
      { label: 'Monthly listeners', value: `${STATS.monthlyListeners} ↗`, href: spotify },
      { label: 'Followers', value: STATS.followers, tab: 'socials' },
      { label: 'Bookings', value: 'Open', href: '#book' },
      { label: 'Date/Time', datetime: true },
    ],
  },
  {
    id: 'collabs', name: 'Collabs', code: 'COLLAB', color: '--tab-blue',
    rows: [
      ...collabs.map((c, i) => ({ label: c.name, value: c.roles[0], sub: `collab-${i}` })),
      { label: 'All work on the card', value: `[${pad2(items.length)}]`, play: true },
    ],
  },
  {
    id: 'socials', name: 'Socials', code: 'SOCIAL', color: '--tab-yellow',
    rows: [
      ...SOCIALS.map((s) => ({ label: s.name, value: `${handle(s.url)} ↗`, href: s.url })),
      { label: 'Email', value: EMAIL, href: `mailto:${EMAIL}` },
    ],
  },
  {
    id: 'specs', name: 'Specs', code: 'SPECS', color: '--tab-green',
    rows: [
      { label: 'Black', swatch: '--lcd' },
      { label: 'White', swatch: '--osd' },
      { label: 'REC red', swatch: '--tally' },
      { label: 'AF green', swatch: '--af' },
      { label: 'Cursor gold', swatch: '--sel' },
      { label: 'Dial orange', swatch: '--dial' },
      { label: 'Set-value blue', swatch: '--cur' },
      { label: 'Type', value: 'Barlow Semi Condensed' },
      { label: 'Buttons + labels', value: 'View', sub: 'buttons' },
    ],
  },
].map((t) => ({ ...t, pages: Array.from({ length: Math.ceil(t.rows.length / 6) }, (_, i) => t.rows.slice(i * 6, i * 6 + 6)) }));
---

<Base title={`Style guide — ${PROFILE.wordmark}`} description="The camera-screen look for regiwock.com." noindex>
  <div class="cam" data-cam data-info="full">
    <!-- Live view: the stream plays muted behind the readouts (pillarboxed to 3:2 on wide screens) -->
    <div class="feed" aria-hidden="true">
      {first?.thumb && <img class="still" src={first.thumb} alt="" data-still onerror="this.hidden=true" />}
      <div class="yt" data-yt></div>
      <svg class="grid-lines" viewBox="0 0 300 200" preserveAspectRatio="none">
        <path d="M100 0V200M200 0V200M0 66.667H300M0 133.333H300M0 0L300 200M300 0L0 200" vector-effect="non-scaling-stroke" />
      </svg>
      <div class="af" data-af></div>
    </div>

    <div class="hud" data-hud>
      <header class="top">
        <div class="top-left">
          <a href="#book" class="rec" aria-label="Book me">
            <span class="rec-dot" aria-hidden="true"></span>REC<span class="chip chip-red">Book me</span>
          </a>
          <button type="button" class="shots" data-open="play" aria-label={`SD card: ${items.length} files`}>[{pad2(items.length)}]</button>
        </div>
        <div class="top-mid">
          <b class="clock" data-time>--:--</b>
          <span class="batt" data-batt hidden><i></i><i></i><i></i></span>
          <button type="button" class="mic" data-sound aria-pressed="false" hidden>
            <svg viewBox="0 0 16 22" aria-hidden="true"><rect x="4.5" y="1" width="7" height="12" rx="3.5" /><path d="M1.5 9.5a6.5 6.5 0 0 0 13 0M8 16v4.5M4.5 20.5h7" /></svg>
            <sub data-sound-label>OFF</sub><span class="sr-only">Sound</span>
          </button>
        </div>
      </header>

      <ul class="side side-left" aria-label="Roles">
        {PROFILE.roles.map((r) => <li class="chip">{r}</li>)}
      </ul>

      <nav class="side side-right" aria-label="Camera buttons">
        <button type="button" class="key" data-open="menu">Menu</button>
        <button type="button" class="key" data-open="play" aria-label="Play: past streams and work">▶</button>
        <button type="button" class="key key-disp" data-info-btn aria-pressed="false"><span class="cam-ico" aria-hidden="true"></span>Disp</button>
      </nav>

      <div class="subject">
        <p class="mark">{PROFILE.wordmark}</p>
        <h1 class="pitch">{PROFILE.pitch}</h1>
        <a href="#book" class="setbtn"><span class="set">SET</span>Book me</a>
      </div>

      <footer class="bottom">
        <div class="reads">
          <button type="button" class="read" data-open="menu" data-tab="about">
            <span class="box">Creating<br />since</span><b>{STATS.creatingSince}</b>
          </button>
          <a class="read" href={spotify} target="_blank" rel="noopener">
            <span class="box">Monthly<br />listeners</span><b>{STATS.monthlyListeners}</b>
          </a>
          <button type="button" class="read" data-open="menu" data-tab="socials">
            <span class="box">Followers</span><b>{STATS.followers}</b>
          </button>
        </div>

        <div class="meter" role="group" aria-label="Footage">
          <p class="now"><span class="dim">CAM <span data-cam-n>1</span>/{clips.length}</span> <span data-now>{first?.title}</span></p>
          <div class="meter-row">
            <button type="button" class="nudge" data-step="-1" aria-label="Previous stream"><i class="dial" aria-hidden="true"></i></button>
            <div class="scale">
              {clips.map((c, i) => (
                <button type="button" class="tick" data-clip={i} aria-label={`Show ${c.title}`} aria-current={i === 0 ? 'true' : undefined}>
                  <span>{i + 1}</span><i></i>
                </button>
              ))}
            </div>
            <button type="button" class="nudge" data-step="1" aria-label="Next stream"><i class="dial dial-down" aria-hidden="true"></i></button>
          </div>
        </div>
      </footer>
    </div>

    <!-- MENU: Canon-style camera menu -->
    <section class="panel panel-menu" data-panel="menu" aria-label="Menu" hidden>
      <div class="menu-list" data-menu-list>
        <div class="tabs" role="tablist">
          {tabs.map((t) => (
            <button type="button" role="tab" class="tab" data-tabbtn={t.id} aria-selected="false" style={`--tc: var(${t.color})`}>{t.name}</button>
          ))}
        </div>
        {tabs.map((t) => (
          <div class="tabpanel" data-tabpanel={t.id} role="tabpanel" hidden>
            <div class="pagebar">
              <div class="pnums">
                {t.pages.map((_, i) => (
                  <button type="button" class="pnum" data-pagebtn={i} aria-label={`Page ${i + 1}`} aria-current={i === 0 ? 'true' : undefined}>{i + 1}</button>
                ))}
              </div>
              <span class="pcode">{t.code}<span data-pcode>1</span></span>
            </div>
            {t.pages.map((rows, i) => (
              <ul class="rows" data-page={i} hidden={i > 0}>
                {rows.map((r) => (
                  <li>
                    {r.href ? (
                      <a class="row" href={r.href} {...(r.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}>
                        <span>{r.label}</span><span class="val">{r.value}</span>
                      </a>
                    ) : r.sub || r.tab || r.play ? (
                      <button type="button" class="row" data-sub={r.sub} data-go-tab={r.tab} data-open={r.play ? 'play' : undefined}>
                        <span>{r.label}</span><span class="val">{r.value}</span>
                      </button>
                    ) : (
                      <div class="row row-info">
                        <span>{r.label}</span>
                        <span class="val">
                          {r.swatch && <><span class="swatch" style={`background: var(${r.swatch})`}></span><span data-hex={r.swatch}></span></>}
                          {r.datetime && <span data-datetime></span>}
                          {r.value}
                        </span>
                      </div>
                    )}
                  </li>
                ))}
                {Array.from({ length: 6 - rows.length }, () => <li class="row-empty" aria-hidden="true"></li>)}
              </ul>
            ))}
          </div>
        ))}
      </div>

      <!-- SET OK sub-screens -->
      <div class="sub" data-subscreen="about" hidden>
        <h2 class="sub-title">About Regi</h2>
        <div class="sub-body sub-text">{ABOUT.map((p) => <p>{p}</p>)}</div>
      </div>
      {collabs.map((c, i) => (
        <div class="sub" data-subscreen={`collab-${i}`} hidden>
          <h2 class="sub-title">{c.name}</h2>
          <div class="sub-body">
            <p class="sub-roles">{c.roles.join(' · ')}</p>
            <p class="sub-line">{c.line}</p>
            <ul class="rows rows-options">
              {c.clip >= 0 && (
                <li><button type="button" class="row" data-onscreen={c.clip}><span>Put on screen</span><span class="val val-cur">CAM {c.clip + 1}</span></button></li>
              )}
              <li><a class="row" href={c.url} target="_blank" rel="noopener"><span>Watch the stream</span><span class="val">YouTube ↗</span></a></li>
            </ul>
          </div>
        </div>
      ))}
      <div class="sub" data-subscreen="buttons" hidden>
        <h2 class="sub-title">Buttons + labels</h2>
        <div class="sub-body specs">
          <p class="pitch s-pitch">Book me.</p>
          <div class="specs-row">
            <span class="setbtn"><span class="set">SET</span>Book me</span>
            <span class="key">Menu</span>
            <span class="key key-disp"><span class="cam-ico" aria-hidden="true"></span>Disp</span>
          </div>
          <div class="specs-row">
            <span class="chip">Artist</span><span class="chip chip-red">Book me</span>
            <span class="read"><span class="box">Monthly<br />listeners</span><b>{STATS.monthlyListeners}</b></span>
            <i class="dial"></i><i class="dial dial-down"></i>
          </div>
          <p class="sub-line">Readouts and labels float on the footage in white with a soft shadow. Gold outline = where the cursor is. Blue = the value that's set.</p>
        </div>
      </div>

      <div class="pfoot">
        <button type="button" class="key" data-close><span>Menu</span> ↩</button>
        <button type="button" class="setok" data-setok hidden><span class="set">SET</span>OK</button>
      </div>
    </section>

    <!-- PLAY: SD-card playback, like flipping through the camera's card -->
    <section class="panel panel-play" data-panel="play" aria-label="SD card" hidden>
      <div class="single" data-single>
        <div class="viewer" data-viewer>
          <img class="v-img" alt="" data-v-img hidden />
          <p class="v-tile" data-v-tile></p>
        </div>
        <p class="osd osd-top"><span>▶ <span data-v-no></span></span><span><span data-play-n>1</span>/{items.length}</span></p>
        <div class="osd osd-bottom">
          <p class="v-file"><span data-v-file></span> <span class="dim" data-v-platform></span></p>
          <h2 class="v-title" data-v-title></h2>
        </div>
      </div>

      <div class="index" data-index hidden>
        <p class="osd idx-top"><span>▶ Index</span><span><span data-page>1</span>/{idxPages}</span></p>
        <ul class="thumbs" data-grid></ul>
      </div>

      <div class="pfoot pfoot-play">
        <button type="button" class="key" data-close>▶ ↩</button>
        <button type="button" class="key key-sq" data-play-step="-1" aria-label="Previous">◀</button>
        <button type="button" class="setok" data-v-set><span class="set">SET</span><span data-v-set-label>On screen</span></button>
        <button type="button" class="key key-sq" data-play-step="1" aria-label="Next">▶</button>
        <button type="button" class="key key-sq" data-index-btn aria-pressed="false" aria-label="Index">⊞</button>
      </div>
    </section>
  </div>

  <script is:inline type="application/json" id="cam-data" set:html={JSON.stringify({ items, clips })}></script>
</Base>

<script>
  type Item = { title: string; type: string; platform: string; url: string; thumb: string; yt: string; file: string; no: string };
  const { items, clips } = JSON.parse(document.getElementById('cam-data')!.textContent!) as { items: Item[]; clips: Item[] };
  const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => [...root.querySelectorAll<T>(s)];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');
  const cam = $('[data-cam]');

  // ---- Clock: the visitor's real time (and date/time in the menu, like the camera's setting) ----
  const tick = () => {
    const d = new Date();
    $('[data-time]').textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}`;
    $$('[data-datetime]').forEach((el) => (el.textContent = `'${String(d.getFullYear()).slice(2)}/${pad(d.getMonth() + 1)}/${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`));
  };
  tick();
  setInterval(tick, 1000);

  // ---- Battery: the visitor's real battery, where the browser shares it (Chrome/Android) ----
  type Battery = EventTarget & { level: number; charging: boolean };
  const nav = navigator as Navigator & { getBattery?: () => Promise<Battery> };
  nav.getBattery?.().then((b) => {
    const el = $('[data-batt]');
    const draw = () => {
      el.hidden = false;
      el.dataset.bars = String(Math.max(1, Math.ceil(b.level * 3)));
      el.toggleAttribute('data-low', b.level <= 0.15 && !b.charging);
      el.title = `Your battery: ${Math.round(b.level * 100)}%`;
    };
    draw();
    b.addEventListener('levelchange', draw);
    b.addEventListener('chargingchange', draw);
  }).catch(() => {});

  // ---- Live view: muted YouTube behind everything; the AF frame goes green once it's really playing ----
  const still = document.querySelector<HTMLImageElement>('[data-still]');
  const ytBox = $('[data-yt]');
  const af = $('[data-af]');
  const soundBtn = $<HTMLButtonElement>('[data-sound]');
  let current = 0;
  let soundOn = false;
  let frame: HTMLIFrameElement | null = null;

  const command = (func: string, args: unknown[] = []) =>
    frame?.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args }), '*');

  const show = (i: number) => {
    current = (i + clips.length) % clips.length;
    const c = clips[current];
    if (still) {
      still.hidden = !c.thumb;
      if (c.thumb) still.src = c.thumb;
    }
    $('[data-now]').textContent = c.title;
    $('[data-cam-n]').textContent = String(current + 1);
    $$('[data-clip]').forEach((t, n) => (n === current ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    if (reduce) return; // Reduced motion: stills only, nothing autoplays.
    af.classList.remove('locked');
    ytBox.replaceChildren();
    ytBox.classList.remove('on');
    const params = new URLSearchParams({
      autoplay: '1', mute: '1', controls: '0', loop: '1', playlist: c.yt, playsinline: '1',
      rel: '0', iv_load_policy: '3', disablekb: '1', modestbranding: '1', enablejsapi: '1', origin: location.origin,
    });
    frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${c.yt}?${params}`;
    frame.allow = 'autoplay; encrypted-media; picture-in-picture';
    frame.tabIndex = -1;
    frame.title = c.title;
    frame.addEventListener('load', () => {
      // Ask the player to report its state so we know when it's really playing.
      frame?.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 'feed', channel: 'widget' }), '*');
    });
    ytBox.append(frame);
  };

  addEventListener('message', (e) => {
    if (!/^https:\/\/www\.youtube(-nocookie)?\.com$/.test(e.origin)) return;
    let data: { event?: string; info?: { playerState?: number } | number };
    try { data = JSON.parse(e.data); } catch { return; }
    if (data.event === 'onReady' && soundOn) command('unMute');
    if (data.event === 'infoDelivery' && typeof data.info === 'object' && data.info?.playerState === 1) {
      ytBox.classList.add('on'); // Show the video only once frames are actually playing.
      af.classList.add('locked');
      soundBtn.hidden = false;
    }
    if (data.event === 'onError') ytBox.replaceChildren(); // Not embeddable: the still stays.
  });

  soundBtn.addEventListener('click', () => {
    soundOn = !soundOn;
    soundBtn.setAttribute('aria-pressed', String(soundOn));
    $('[data-sound-label]').textContent = soundOn ? 'ON' : 'OFF';
    command(soundOn ? 'unMute' : 'mute');
    if (soundOn) command('setVolume', [70]);
  });
  $$('[data-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.step))));
  $$('[data-clip]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.clip))));
  if (clips.length) show(0);

  // ---- DISP: like the camera button, flips between the full display and a clean view ----
  const infoBtn = $('[data-info-btn]');
  infoBtn.addEventListener('click', () => {
    const clean = cam.dataset.info === 'full';
    cam.dataset.info = clean ? 'clean' : 'full';
    infoBtn.setAttribute('aria-pressed', String(clean));
  });

  // ---- Panels (MENU / PLAY) over the live view; no page scroll anywhere ----
  const hud = $('[data-hud]');
  let openPanel: HTMLElement | null = null;
  const close = () => {
    if (!openPanel) return;
    openPanel.hidden = true;
    openPanel = null;
    hud.inert = false;
  };
  const open = (name: string, tab?: string) => {
    close();
    openPanel = $(`[data-panel="${name}"]`);
    openPanel.hidden = false;
    hud.inert = true;
    if (name === 'menu') { closeSub(); selectTab(tab || 'about'); }
    if (name === 'play') { setIndex(false); showItem(playIndex); $<HTMLButtonElement>('[data-close]', openPanel).focus({ preventScroll: true }); }
  };
  $$('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open!, b.dataset.tab)));

  // Menu: colored tabs, numbered pages of 6 rows, the gold cursor sits on the focused row.
  const tabIds = $$('[data-tabbtn]').map((b) => b.dataset.tabbtn!);
  const list = $('[data-menu-list]');
  const setOk = $('[data-setok]');
  let tab = 'about';
  let sub: HTMLElement | null = null;
  let subFrom: HTMLElement | null = null;
  const actionable = (root: ParentNode) => $$<HTMLElement>('a.row, button.row', root).filter((r) => !r.closest('[hidden]'));
  const panelOf = (t: string) => $(`[data-tabpanel="${t}"]`);
  const setPage = (t: string, p: number, focus: 'first' | 'last' | false = 'first') => {
    const panel = panelOf(t);
    const pages = $$('[data-page]', panel);
    const n = (p + pages.length) % pages.length;
    pages.forEach((ul, i) => (ul.hidden = i !== n));
    $$('[data-pagebtn]', panel).forEach((b, i) => (i === n ? b.setAttribute('aria-current', 'true') : b.removeAttribute('aria-current')));
    $('[data-pcode]', panel).textContent = String(n + 1);
    const rows = actionable(pages[n]);
    if (focus && rows.length) rows[focus === 'first' ? 0 : rows.length - 1].focus({ preventScroll: true });
    return n;
  };
  const selectTab = (t: string, focusTab = false) => {
    tab = t;
    $$('[data-tabbtn]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tabbtn === t)));
    $$('[data-tabpanel]').forEach((p) => (p.hidden = p.dataset.tabpanel !== t));
    setPage(t, 0, focusTab ? false : 'first');
    if (focusTab) $<HTMLButtonElement>(`[data-tabbtn="${t}"]`).focus({ preventScroll: true });
  };
  $$('[data-tabbtn]').forEach((b) => b.addEventListener('click', () => selectTab(b.dataset.tabbtn!, true)));
  $$('[data-tabpanel]').forEach((panel) =>
    $$('[data-pagebtn]', panel).forEach((b) => b.addEventListener('click', () => setPage(panel.dataset.tabpanel!, Number(b.dataset.pagebtn), false))),
  );
  $$<HTMLElement>('[data-go-tab]').forEach((b) => b.addEventListener('click', () => selectTab(b.dataset.goTab!)));
  // Hovering a row moves the cursor there, like the camera.
  $$<HTMLElement>('.panel-menu a.row, .panel-menu button.row').forEach((r) =>
    r.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && r.focus({ preventScroll: true })),
  );

  const openSub = (id: string, from: HTMLElement) => {
    sub = $(`[data-subscreen="${id}"]`);
    subFrom = from;
    list.hidden = true;
    sub.hidden = false;
    setOk.hidden = false;
    const rows = actionable(sub);
    (rows[0] ?? setOk).focus({ preventScroll: true });
  };
  const closeSub = () => {
    if (!sub) return false;
    sub.hidden = true;
    sub = null;
    list.hidden = false;
    setOk.hidden = true;
    subFrom?.focus({ preventScroll: true });
    return true;
  };
  $$<HTMLElement>('[data-sub]').forEach((b) => b.dataset.sub && b.addEventListener('click', () => openSub(b.dataset.sub!, b)));
  setOk.addEventListener('click', closeSub);
  // MENU ↩ backs out one level: sub-screen → list → live view.
  $$('[data-close]').forEach((b) => b.addEventListener('click', () => (openPanel?.dataset.panel === 'menu' && closeSub()) || close()));

  const onScreen = (clip: number) => {
    closeSub();
    close();
    show(clip);
  };
  $$('[data-onscreen]').forEach((b) => b.addEventListener('click', () => onScreen(Number(b.dataset.onscreen))));

  // Playback: one file at a time (◀ ▶ / arrow keys / swipe), ⊞ for the index of thumbnails.
  let playIndex = 0;
  let indexMode = false;
  const single = $('[data-single]');
  const index = $('[data-index]');
  const indexBtn = $('[data-index-btn]');
  const viewer = $('[data-viewer]');
  const vImg = $<HTMLImageElement>('[data-v-img]');
  const vTile = $('[data-v-tile]');
  const setBtn = $('[data-v-set]');
  const setLabel = $('[data-v-set-label]');
  const clipOf = (it: Item) => clips.findIndex((c) => c.url === it.url);
  const labelSet = () => (setLabel.textContent = indexMode ? 'View' : clipOf(items[playIndex]) >= 0 ? 'On screen' : 'Open ↗');

  const showItem = (i: number) => {
    playIndex = (i + items.length) % items.length;
    const it = items[playIndex];
    $('[data-play-n]').textContent = String(playIndex + 1);
    $('[data-v-no]').textContent = it.no;
    $('[data-v-file]').textContent = it.file;
    $('[data-v-platform]').textContent = it.platform;
    $('[data-v-title]').textContent = it.title;
    vTile.textContent = it.title;
    vImg.hidden = !it.thumb;
    vTile.hidden = !!it.thumb;
    if (it.thumb) vImg.src = it.thumb;
    labelSet();
    // Hard cut: the screen blanks for a frame between files, like the camera redrawing.
    if (!reduce) {
      viewer.classList.remove('cut');
      void viewer.offsetWidth;
      viewer.classList.add('cut');
    }
    if (indexMode) drawIndex();
  };
  vImg.addEventListener('error', () => ((vImg.hidden = true), (vTile.hidden = false)));
  setBtn.addEventListener('click', () => {
    if (indexMode) return setIndex(false);
    const it = items[playIndex];
    const clip = clipOf(it);
    if (clip >= 0) onScreen(clip);
    else window.open(it.url, '_blank', 'noopener');
  });
  $$('[data-play-step]').forEach((b) => b.addEventListener('click', () => showItem(playIndex + Number(b.dataset.playStep))));

  const grid = $('[data-grid]');
  const tile = (text: string) => Object.assign(document.createElement('span'), { className: 'cell-tile', textContent: text });
  const drawIndex = () => {
    const page = Math.floor(playIndex / 9);
    $('[data-page]').textContent = String(page + 1);
    grid.replaceChildren(
      ...items.slice(page * 9, page * 9 + 9).map((it, k) => {
        const n = page * 9 + k;
        const li = document.createElement('li');
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cell';
        b.setAttribute('aria-label', `${it.file}: ${it.title}`);
        if (n === playIndex) b.setAttribute('aria-current', 'true');
        if (it.thumb) {
          const img = document.createElement('img');
          img.src = it.thumb;
          img.alt = '';
          img.onerror = () => img.replaceWith(tile(it.title));
          b.append(img);
        } else {
          b.append(tile(it.title));
        }
        b.addEventListener('click', () => {
          setIndex(false);
          showItem(n);
        });
        li.append(b);
        return li;
      }),
    );
  };
  const setIndex = (on: boolean) => {
    indexMode = on;
    single.hidden = on;
    index.hidden = !on;
    indexBtn.setAttribute('aria-pressed', String(on));
    labelSet();
    if (on) drawIndex();
  };
  indexBtn.addEventListener('click', () => setIndex(!indexMode));

  let x0: number | null = null;
  const swipe = $('[data-panel="play"]');
  swipe.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  swipe.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) showItem(playIndex + (dx < 0 ? 1 : -1) * (indexMode ? 9 : 1));
    x0 = null;
  });

  // ---- Keys: arrows flip streams / tabs / rows / files; Esc backs out ----
  addEventListener('keydown', (e) => {
    if ((document.getElementById('book') as HTMLDialogElement).open) return;
    const k = e.key;
    if (k === 'Escape') {
      if (openPanel?.dataset.panel === 'play' && indexMode) return setIndex(false);
      if (openPanel?.dataset.panel === 'menu' && closeSub()) return;
      return close();
    }
    if (!openPanel) {
      if (k === 'ArrowLeft' || k === 'ArrowRight') show(current + (k === 'ArrowLeft' ? -1 : 1));
      return;
    }
    if (!k.startsWith('Arrow')) return;
    if (openPanel.dataset.panel === 'play') {
      if (k === 'ArrowLeft' || k === 'ArrowRight') showItem(playIndex + (k === 'ArrowLeft' ? -1 : 1));
      if (indexMode && (k === 'ArrowUp' || k === 'ArrowDown')) { e.preventDefault(); showItem(playIndex + (k === 'ArrowUp' ? -3 : 3)); }
      return;
    }
    e.preventDefault();
    if (sub) {
      const rows = [...actionable(sub), setOk];
      const at = rows.indexOf(document.activeElement as HTMLElement);
      if (k === 'ArrowUp' || k === 'ArrowDown') rows[(at + (k === 'ArrowUp' ? -1 : 1) + rows.length) % rows.length].focus();
      return;
    }
    if (k === 'ArrowLeft' || k === 'ArrowRight') {
      selectTab(tabIds[(tabIds.indexOf(tab) + (k === 'ArrowLeft' ? -1 : 1) + tabIds.length) % tabIds.length]);
      return;
    }
    // Up/Down move the cursor; past the last row it flips to the next numbered page.
    const pages = $$('[data-page]', panelOf(tab));
    const page = pages.findIndex((p) => !p.hidden);
    const rows = actionable(pages[page]);
    const at = rows.indexOf(document.activeElement as HTMLElement);
    const next = at + (k === 'ArrowUp' ? -1 : 1);
    if (at >= 0 && next >= 0 && next < rows.length) rows[next].focus();
    else if (pages.length > 1 && at >= 0) setPage(tab, page + (k === 'ArrowUp' ? -1 : 1), k === 'ArrowUp' ? 'last' : 'first');
    else rows[k === 'ArrowUp' ? rows.length - 1 : 0]?.focus();
  });

  // Specs: show each token's hex, read back from the CSS.
  const css = getComputedStyle(document.documentElement);
  $$('[data-hex]').forEach((el) => (el.textContent = css.getPropertyValue(el.dataset.hex!).trim().toUpperCase()));
</script>

<style>
  /* ---- Tokens for this look: the only place colors and fonts are set. On :root so the Book me sheet reskins too. ---- */
  :global(:root:root) {
    color-scheme: dark;
    --lcd: #000000;
    --lcd-2: #2b2b2b;
    --osd: #ffffff;
    --osd-dim: #a8a8a8;
    --rule: #3c3c3c;
    --tally: #e8231b;
    --af: #3fd24a;
    --sel: #f2a51a;
    --dial: #f7931e;
    --cur: #5cb8ff;
    --tab-red: #e0342b;
    --tab-blue: #3f86e8;
    --tab-yellow: #e9b200;
    --tab-green: #3db552;
    --f-ui: "Barlow Semi Condensed", "Arial Narrow", system-ui, sans-serif;

    /* Mapped onto the site-wide names so shared components (Book me sheet) follow along. */
    --bg: var(--lcd); --bg-2: var(--lcd-2); --panel: var(--lcd-2); --ink: var(--osd); --muted: var(--osd-dim);
    --line: var(--rule); --accent: var(--tally); --accent-ink: var(--osd); --accent-fill: var(--tally); --ok: var(--af);
    --f-display: var(--f-ui); --f-body: var(--f-ui); --f-mono: var(--f-ui); --f-hand: var(--f-ui);
    /* Camera readouts: white with a soft dark edge so they read over any footage. */
    --osd-shadow: 0 0 2px rgb(0 0 0 / 0.9), 0 1px 3px rgb(0 0 0 / 0.7);
  }
  :global(html), :global(body) { height: 100%; overflow: hidden; overscroll-behavior: none; background: var(--lcd); }
  :global(body::after) { display: none; }
  :global(dialog.sheet::backdrop) { background: rgb(0 0 0 / 0.7); }
  :global(dialog.sheet .sheet-page) { border: 1px solid var(--rule); box-shadow: none; outline: 0; border-radius: 0; }
  :global(:root dialog.sheet[open] .sheet-page) { animation: none; }
  :global(dialog.sheet .display) { font-weight: 700; letter-spacing: 0; }
  :global(dialog.sheet .label) { font-size: 15px; letter-spacing: 0.04em; }
  :global(dialog.sheet .hand) { font-size: 20px; }
  :global(:focus-visible) { outline: 2px solid var(--sel); outline-offset: 2px; }

  .cam {
    position: fixed; inset: 0; overflow: hidden; background: var(--lcd); color: var(--osd);
    font: 500 18px/1.15 var(--f-ui); text-shadow: var(--osd-shadow);
  }
  .cam :is(button, a) { letter-spacing: inherit; }
  .dim { color: var(--osd-dim); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---- Live view (3:2 like the camera's sensor, pillarboxed on wide screens) ---- */
  .feed {
    position: absolute; inset: 0 max(0px, calc((100vw - 150svh) / 2)); overflow: hidden; container-type: size;
    background: radial-gradient(120% 90% at 60% 35%, var(--lcd-2), var(--lcd));
  }
  .still, .yt :global(iframe) {
    position: absolute; top: 50%; left: 50%; translate: -50% -50%; border: 0;
    width: max(100cqw, 177.78cqh); height: max(100cqh, 56.25cqw);
  }
  .still { object-fit: cover; }
  /* Oversize the video a little so YouTube's own title/branding falls outside the screen. */
  .yt :global(iframe) { width: calc(max(100cqw, 177.78cqh) * 1.18); height: calc(max(100cqh, 56.25cqw) * 1.18); pointer-events: none; }
  .yt { position: absolute; inset: 0; visibility: hidden; }
  .yt.on { visibility: visible; }
  .grid-lines { position: absolute; inset: 0; width: 100%; height: 100%; fill: none; stroke: rgb(255 255 255 / 0.42); stroke-width: 1; }
  /* AF frame: white while it searches, green once the stream is actually playing. */
  .af { position: absolute; top: 50%; left: 50%; width: 72px; height: 52px; translate: -50% -50%; border: 2px solid var(--osd); filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.8)); }
  .af.locked { border-color: var(--af); }

  /* ---- Readouts, laid out like the Canon live view ---- */
  .hud {
    position: absolute; inset: 0; display: grid;
    grid-template-columns: auto 1fr auto; grid-template-rows: auto 1fr auto auto;
    grid-template-areas: "top top top" "left . right" "subject subject subject" "bottom bottom bottom";
    column-gap: 12px;
    padding: max(10px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(8px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
  }
  .top { grid-area: top; display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .top-left { display: flex; align-items: center; gap: 12px; }
  .rec { display: inline-flex; align-items: center; gap: 7px; min-height: 44px; font-size: 32px; font-weight: 700; line-height: 1; white-space: nowrap; }
  .rec-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--tally); }
  .rec .chip { margin-left: 4px; }
  .rec:hover .chip, .rec:focus-visible .chip { background: var(--osd); color: var(--lcd); }
  .shots { min-height: 44px; font-size: 26px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .shots:hover { color: var(--sel); }
  .top-mid { display: flex; align-items: center; gap: 10px; }
  .clock { font-size: 28px; font-weight: 600; font-variant-numeric: tabular-nums; }

  /* Battery like the camera's: outline, nub, up to 3 bars. */
  .batt { position: relative; display: inline-flex; gap: 2px; width: 30px; height: 14px; padding: 2px; border: 1.5px solid var(--osd); border-radius: 2px; filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.8)); }
  .batt::after { content: ""; position: absolute; right: -5px; top: 3px; width: 3px; height: 5px; background: var(--osd); }
  .batt i { flex: 1; background: var(--osd); }
  .batt[data-bars="1"] i:nth-child(n + 2), .batt[data-bars="2"] i:nth-child(3) { visibility: hidden; }
  .batt[data-low] { border-color: var(--tally); }
  .batt[data-low] i { background: var(--tally); }
  /* Mic with OFF/ON underneath = the sound toggle, like the camera's recording-level icon. */
  .mic { display: inline-flex; align-items: flex-end; min-width: 44px; min-height: 44px; justify-content: center; }
  .mic svg { width: 14px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; filter: drop-shadow(0 0 1px rgb(0 0 0 / 0.8)); }
  .mic svg rect { fill: currentColor; stroke: none; }
  .mic sub { font-size: 12px; font-weight: 700; line-height: 1; margin-bottom: 11px; }
  .mic[aria-pressed="true"] { color: var(--cur); }

  /* Boxed labels: filled like RAW (chip), outlined like ISO (box) */
  .chip { display: inline-block; padding: 1px 5px; border-radius: 3px; background: var(--osd); color: var(--lcd); font-size: 13px; font-weight: 700; line-height: 1.2; text-transform: uppercase; text-shadow: none; white-space: nowrap; box-shadow: 0 0 2px rgb(0 0 0 / 0.6); }
  .chip-red { background: var(--tally); color: var(--osd); }
  .box { display: inline-block; padding: 1px 3px; border: 1.5px solid currentColor; border-radius: 2px; font-size: 10px; font-weight: 700; line-height: 1.05; text-transform: uppercase; text-align: center; }

  .side { display: grid; gap: 14px; align-content: center; justify-items: start; }
  .side-left { grid-area: left; }
  .side-right { grid-area: right; justify-items: end; gap: 8px; }
  .key {
    display: inline-flex; align-items: center; justify-content: center; gap: 5px; min-width: 44px; min-height: 44px; padding: 0 10px;
    border: 1.5px solid var(--osd); border-radius: 4px; background: rgb(0 0 0 / 0.35);
    font-size: 17px; font-weight: 700; line-height: 1; text-transform: uppercase; white-space: nowrap; box-shadow: 0 0 2px rgb(0 0 0 / 0.6);
  }
  .key:hover, .key:focus-visible { border-color: var(--sel); color: var(--sel); outline: 0; }
  .key:active { background: var(--sel); color: var(--lcd); text-shadow: none; }
  .key[aria-pressed="true"] { color: var(--cur); border-color: var(--cur); }
  .cam-ico { position: relative; width: 14px; height: 10px; border-radius: 2px; background: currentColor; }
  .cam-ico::before { content: ""; position: absolute; left: 3px; top: -3px; width: 5px; height: 3px; background: currentColor; }
  .cam-ico::after { content: ""; position: absolute; left: 4px; top: 2px; width: 6px; height: 6px; border-radius: 50%; background: var(--lcd); }

  .subject { grid-area: subject; display: grid; justify-items: start; gap: 6px; padding-bottom: 10px; max-width: 60rem; }
  .mark { font-size: 20px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; }
  .pitch { font-size: clamp(38px, 11vw, 96px); font-weight: 700; line-height: 0.95; letter-spacing: -0.01em; }
  /* SET + label, with the gold cursor around it: the camera's "this is selected, press SET". */
  .setbtn, .setok {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 16px 0 10px;
    border: 2px solid var(--sel); background: rgb(0 0 0 / 0.55); font-size: 24px; font-weight: 600; line-height: 1; white-space: nowrap;
  }
  .setbtn:hover, .setbtn:focus-visible, .setok:hover, .setok:focus-visible { background: var(--sel); color: var(--lcd); text-shadow: none; outline: 0; }
  .set { padding: 2px 5px; border-radius: 3px; background: var(--osd); color: var(--lcd); font-size: 14px; font-weight: 700; text-shadow: none; }
  .setbtn:hover .set, .setbtn:focus-visible .set, .setok:hover .set, .setok:focus-visible .set { background: var(--lcd); color: var(--osd); }

  .bottom { grid-area: bottom; display: grid; gap: 4px; }
  .reads { display: flex; justify-content: space-between; gap: 6px; }
  .read { display: inline-flex; flex-direction: column; align-items: flex-start; gap: 3px; min-height: 44px; }
  .read b { font-size: 28px; font-weight: 600; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .read:hover, .read:focus-visible { color: var(--sel); outline: 0; }
  .meter { display: grid; justify-items: center; min-width: 0; }
  .meter-row { display: flex; align-items: center; }
  .now { max-width: 100%; font-size: 16px; font-weight: 600; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Orange dial marks: turn this to change the stream. */
  .nudge { display: grid; place-items: center; width: 44px; height: 44px; }
  .dial {
    display: inline-block; width: 30px; height: 15px; border: 5px solid var(--dial); border-bottom: 0; border-radius: 15px 15px 0 0;
    -webkit-mask: repeating-conic-gradient(from -90deg at 50% 100%, #000 0 13deg, transparent 13deg 20deg);
    mask: repeating-conic-gradient(from -90deg at 50% 100%, #000 0 13deg, transparent 13deg 20deg);
  }
  .dial-down { rotate: 180deg; }
  .nudge:hover .dial { border-color: var(--sel); }
  /* The exposure scale, one mark per stream: numbers with dots between, ticks under, the marker on the live one. */
  .scale { display: flex; }
  .tick { position: relative; display: grid; justify-items: center; align-content: center; gap: 3px; width: 40px; height: 44px; font-size: 18px; font-weight: 600; }
  .tick + .tick::before { content: ".."; position: absolute; left: -5px; top: 7px; font-size: 18px; }
  .tick i { width: 5px; height: 10px; background: var(--osd); box-shadow: 0 0 2px rgb(0 0 0 / 0.8); }
  .tick span { height: 20px; line-height: 20px; }
  .tick[aria-current] span { color: transparent; text-shadow: none; position: relative; }
  .tick[aria-current] span::after { content: ""; position: absolute; left: 50%; top: 3px; width: 9px; height: 15px; translate: -50% 0; border-radius: 3px 3px 5px 5px; background: var(--osd); box-shadow: 0 0 2px rgb(0 0 0 / 0.8); }
  .tick:hover span { color: var(--sel); }

  [data-info="clean"] :is(.side-left, .subject, .reads, .meter, .grid-lines, .shots) { visibility: hidden; }
  [data-info="clean"] .side-right .key:not([data-info-btn]) { visibility: hidden; }

  /* ---- Desktop / landscape: Canon's bottom row, everything in one line ---- */
  @media (min-width: 900px) {
    .hud { padding: 16px 22px 12px; column-gap: 24px; }
    .top { padding: 0 0 0 4px; }
    .rec { font-size: clamp(40px, 6svh, 60px); }
    .rec-dot { width: 18px; height: 18px; }
    .shots { font-size: clamp(28px, 4.4svh, 44px); }
    .top-mid { position: absolute; left: 50%; translate: -50% 0; top: 16px; min-height: 44px; }
    .clock { font-size: clamp(32px, 4.8svh, 48px); }
    .chip { font-size: 15px; }
    .side-right .key { font-size: 19px; min-height: 48px; }
    .subject { padding: 0 0 12px 11%; }
    .pitch { font-size: clamp(48px, 5.4vw, 88px); }
    .bottom { display: flex; justify-content: center; align-items: flex-end; gap: 28px; }
    .reads { display: contents; }
    .read { flex-direction: row; align-items: center; gap: 8px; }
    .read:nth-child(3) { order: 3; }
    .meter { order: 2; }
    .read b { font-size: clamp(32px, 4.8svh, 48px); }
    .box { font-size: 11px; }
    .tick { width: 48px; height: 56px; font-size: 24px; }
    .tick + .tick::before { font-size: 24px; left: -7px; top: 6px; }
    .tick span { height: 28px; line-height: 28px; }
    .tick i { width: 6px; height: 14px; }
    .tick[aria-current] span::after { width: 11px; height: 20px; top: 5px; }
    .now { font-size: 17px; }
  }
  @media (max-height: 480px) and (orientation: landscape) {
    .top-mid { position: static; translate: none; }
    .bottom { grid-template-columns: auto 1fr auto; align-items: end; }
    .reads { display: contents; }
    .read { flex-direction: row; align-items: center; }
    .read:nth-child(1) { display: none; }
    .read:nth-child(2) { grid-row: 1; grid-column: 1; }
    .read:nth-child(3) { grid-row: 1; grid-column: 3; }
    .meter { grid-row: 1; grid-column: 2; }
    .now { display: none; }
    .pitch { font-size: clamp(30px, 9svh, 52px); }
    .mark, .side-left, .af { display: none; }
    .side-right { grid-auto-flow: column; align-content: start; }
  }
  @media (max-height: 700px) and (max-width: 899px) {
    .pitch { font-size: clamp(32px, 9.5vw, 42px); }
    .mark { font-size: 17px; }
    .side-left, .af { display: none; }
    .side-right { gap: 6px; }
  }
  @media (max-width: 380px) {
    .read b { font-size: 24px; }
    .box { font-size: 9px; }
    .rec { font-size: 28px; }
    .top-left { gap: 8px; }
  }

  /* ---- Panels ---- */
  .panel {
    position: absolute; inset: 0; z-index: 5; display: grid; grid-template-rows: 1fr auto; gap: 10px;
    padding: max(10px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(10px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
    background: var(--lcd); text-shadow: none;
  }
  .panel[hidden], .menu-list[hidden], .sub[hidden] { display: none; }
  .pfoot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }

  /* Menu: category tabs, numbered pages, rows with a gold cursor */
  .panel-menu { padding-inline: max(12px, calc((100vw - 760px) / 2)); }
  .menu-list { min-height: 0; display: grid; grid-template-rows: auto 1fr; align-content: start; }
  .tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 3px; }
  .tab { min-height: 44px; background: var(--lcd-2); color: var(--tc); font-size: 19px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; }
  .tab[aria-selected="true"] { background: var(--tc); color: var(--lcd); }
