---
// Roadmap 2.1, round 2. Regi picked direction 3 (Broadcast) and asked for:
// no fake timers (every number must be real), the whole site framed like a camera's
// preview screen, and footage (a reel later, a stream still for now) inside it.
// Hidden page: not linked anywhere, noindex.
import '@fontsource/doto/latin-900.css';
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import Base from '../layouts/Base.astro';
import { PROFILE, COLLABS } from '../config';
import { detect } from '../lib/platforms.mjs';

const sample = COLLABS[0];
const thumb = detect(sample.url).thumbnail;
const roles = PROFILE.roles.join(' · ');

const changes = [
  ['Timers', 'No more random numbers. The timecode is the real time on your phone, down to the frame.'],
  ['Frame', 'The whole site is a camera preview: REC light, timecode, framing corners and a center mark on every page.'],
  ['Footage', 'The home page shows footage in the preview. A stream still for now, your highlight reel later (muted, tap for sound).'],
  ['Drawing', 'The falling-up drawing is gone.'],
];

const readouts = [
  ['● REC', 'Top left', 'The camera is rolling. Blinks once a second.'],
  ['TOD 00:00:00:00', 'Top middle', 'Time of day: hours, minutes, seconds, frames. It’s the visitor’s real clock.'],
  ['30P', 'Top right', 'The frame rate the timecode counts in (30 frames a second).'],
  ['STYLE GUIDE', 'Bottom left', 'Which page you’re on.'],
  ['THU 24 SEP 2026', 'Bottom middle', 'Today’s date on the visitor’s phone.'],
  ['390×844', 'Bottom right', 'The visitor’s screen size, live. Turn your phone and it changes.'],
];

const swatches = [
  { name: 'Studio', hex: '#0B0C0D', use: 'Background' },
  { name: 'Panel', hex: '#15171A', use: 'Cards, sheets' },
  { name: 'Signal', hex: '#EEF0EC', use: 'Text, corners' },
  { name: 'Steel', hex: '#8B9096', use: 'Secondary text' },
  { name: 'Tally red', hex: '#FF3B2F', use: 'REC, Book me' },
  { name: 'Preview green', hex: '#3DDC84', use: 'Tap, sent, live' },
];
---

<Base title={`Style guide — ${PROFILE.wordmark}`} description="The Viewfinder look for regiwock.com." noindex>
  <!-- Viewfinder frame: fixed over every page. All readouts are real. -->
  <div class="finder" aria-hidden="true">
    <div class="bar bar-top">
      <span class="rec"><i></i> REC</span>
      <span class="num"><span class="dim">TOD</span> <span data-tc>--:--:--:--</span></span>
      <span>30P</span>
    </div>
    <span class="corner c1"></span><span class="corner c2"></span><span class="corner c3"></span><span class="corner c4"></span>
    <span class="center"></span>
    <div class="bar bar-bottom">
      <span>Style guide</span>
      <span class="num" data-date>&nbsp;</span>
      <span class="num" data-size>&nbsp;</span>
    </div>
  </div>

  <main class="sg">
    <section class="block scene" data-scene>
      <p class="label muted enter" style="--i:0">{PROFILE.wordmark} · Style guide · Round 2 of 3</p>
      <h1 class="display sg-title enter" style="--i:1">Viewfinder</h1>
      <p class="lead enter" style="--i:2">
        You picked 3. It’s now a camera preview: the whole site sits inside the frame, and every number on screen is real.
      </p>
      <ul class="changes enter" style="--i:3">
        {changes.map(([k, v]) => (
          <li><span class="label">{k}</span><span>{v}</span></li>
        ))}
      </ul>
    </section>

    <!-- Hero sample: the camera preview with footage in it -->
    <section class="block scene" data-scene>
      <p class="label block-label">Home page sample</p>
      <div class="monitor">
        <div class="footage">
          {thumb && <img src={thumb} alt="" decoding="async" onerror="this.remove()" />}
        </div>
        <span class="lock" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <div class="mon-top enter" style="--i:0">
          <span class="display mon-mark">{PROFILE.wordmark}</span>
          <span class="label">Work ↗</span>
        </div>
        <p class="label mon-src enter" style="--i:1">Footage · {sample.name}</p>
        <div class="mon-bottom">
          <p class="display pitch" aria-label={PROFILE.pitch}>
            <span class="enter" style="--i:2">The glue</span>
            <span class="enter" style="--i:3">since 1999.</span>
          </p>
          <p class="label muted enter" style="--i:4">{roles}</p>
          <div class="mon-actions enter" style="--i:5">
            <button type="button" class="b b-primary">
              <span class="bk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              Book me <span aria-hidden="true">→</span>
            </button>
            <button type="button" class="b b-sound" aria-pressed="false" data-sound>
              <span class="bk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
              <span data-sound-label>Muted · tap for sound</span>
            </button>
          </div>
        </div>
      </div>
      <p class="note">This is a still from the {sample.name} stream. Your highlight reel plays here later (roadmap 5.3). The sound button is just the look for now.</p>
      <button type="button" class="replay label" data-replay>↻ Replay motion</button>
    </section>

    <section class="block scene" data-scene>
      <p class="label block-label">The frame · on every page</p>
      <ul class="readouts">
        {readouts.map(([sample, where, what]) => (
          <li>
            <span class="label ro-sample">{sample}</span>
            <span class="label muted">{where}</span>
            <span class="ro-what">{what}</span>
          </li>
        ))}
      </ul>
      <p class="note">Plus four framing corners and a faint center mark, like the guides on a camera screen.</p>
    </section>

    <section class="block scene" data-scene>
      <p class="label block-label">Colors</p>
      <ul class="swatches">
        {swatches.map((s) => (
          <li>
            <span class="chip" style={`background:${s.hex}`}></span>
            <span class="sw-name">{s.name}</span>
            <span class="label muted sw-meta">{s.hex} · {s.use}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="block scene" data-scene>
      <p class="label block-label">Type</p>
      <div class="type">
        <p class="label muted t-meta">Display · Doto 900 · dot matrix</p>
        <p class="display t-display">Book me.</p>
        <p class="label muted t-meta">Heading · Geist Sans 600</p>
        <p class="t-h">Stream production</p>
        <p class="label muted t-meta">Body · Geist Sans 400</p>
        <p class="t-body">I like putting smart, creative people from different worlds in the same room and giving everyone a voice.</p>
        <p class="label muted t-meta">Label · Geist Mono · caps</p>
        <p class="label">Camera · Tech setup · Live</p>
        <p class="label muted t-meta">Readout · Geist Mono · even-width numbers</p>
        <p class="label num t-readout"><span class="dim">TOD</span> <span data-tc>--:--:--:--</span></p>
      </div>
    </section>

    <section class="block scene" data-scene>
      <p class="label block-label">Buttons</p>
      <div class="btn-grid">
        <div>
          <p class="label muted t-meta">Primary</p>
          <button type="button" class="b b-primary">
            <span class="bk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            Book me <span aria-hidden="true">→</span>
          </button>
        </div>
        <div>
          <p class="label muted t-meta">Secondary</p>
          <button type="button" class="b b-secondary">
            <span class="bk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            See work
          </button>
        </div>
        <div aria-hidden="true">
          <p class="label muted t-meta">Primary · hover</p>
          <span class="b b-primary is-hover">
            <span class="bk"><i></i><i></i><i></i><i></i></span>
            Book me <span>→</span>
          </span>
        </div>
        <div aria-hidden="true">
          <p class="label muted t-meta">Secondary · hover</p>
          <span class="b b-secondary is-hover">
            <span class="bk"><i></i><i></i><i></i><i></i></span>
            See work
          </span>
        </div>
      </div>
      <p class="note">Corners snap onto whatever you touch, like a camera locking focus.</p>
    </section>

    <section class="block scene" data-scene>
      <p class="label block-label">Work card · tap it</p>
      <article class="card" tabindex="0" data-card>
        <div class="card-media">
          {thumb && <img src={thumb} alt="" loading="lazy" decoding="async" onerror="this.remove()" />}
          <span class="lock" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span class="label card-rec" aria-hidden="true"><b></b> Play</span>
        </div>
        <div class="card-body">
          <div>
            <p class="label card-tags"><span class="tag">Stream</span> <span class="muted">YouTube</span></p>
            <h3 class="card-title">{sample.name}</h3>
            <p class="card-line muted">{sample.roles.join(' · ')}</p>
          </div>
          <span class="card-go" aria-hidden="true">→</span>
        </div>
      </article>
    </section>

    <section class="block scene" data-scene>
      <p class="label block-label">Motion</p>
      <p class="t-body">
        Snap cuts, like switching cameras. Each section flickers on as it enters the frame, corners lock onto what you touch, and the REC
        light blinks. The timecode moves because it’s the real time. Nothing else counts or spins.
      </p>
    </section>
  </main>
</Base>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Real readouts: the visitor's time of day (HH:MM:SS:FF at 30fps), date and screen size.
  const tcs = document.querySelectorAll<HTMLElement>('[data-tc]');
  const dateEl = document.querySelector<HTMLElement>('[data-date]');
  const sizeEl = document.querySelector<HTMLElement>('[data-size]');
  const pad = (n: number) => String(n).padStart(2, '0');
  let lastTc = '';
  const tick = () => {
    const d = new Date();
    const tc = [d.getHours(), d.getMinutes(), d.getSeconds(), Math.floor(d.getMilliseconds() / (1000 / 30))].map(pad).join(':');
    if (tc !== lastTc) {
      lastTc = tc;
      tcs.forEach((el) => (el.textContent = tc));
    }
    if (dateEl) {
      const [wd, mo] = [d.toLocaleDateString('en-US', { weekday: 'short' }), d.toLocaleDateString('en-US', { month: 'short' })];
      dateEl.textContent = `${wd} ${pad(d.getDate())} ${mo} ${d.getFullYear()}`;
    }
  };
  // Reduced motion: update once a second instead of every frame.
  if (reduce) setInterval(tick, 1000);
  else {
    const loop = () => (tick(), requestAnimationFrame(loop));
    requestAnimationFrame(loop);
  }
  tick();
  const size = () => sizeEl && (sizeEl.textContent = `${innerWidth}×${innerHeight}`);
  addEventListener('resize', size);
  size();

  // Sections flicker on as they enter the frame; "Replay" restarts the hero.
  const play = (el: HTMLElement) => {
    el.classList.remove('play');
    void el.offsetWidth;
    el.classList.add('play');
  };
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && (play(e.target as HTMLElement), io.unobserve(e.target))),
    { threshold: 0.15 },
  );
  document.querySelectorAll<HTMLElement>('[data-scene]').forEach((s) => io.observe(s));
  document.querySelectorAll<HTMLElement>('[data-replay]').forEach((b) => b.addEventListener('click', () => play(b.closest('[data-scene]')!)));

  // Phones can't hover: tapping the card toggles its focus-lock state.
  document.querySelectorAll<HTMLElement>('[data-card]').forEach((c) => c.addEventListener('click', () => c.classList.toggle('is-on')));

  // Sound toggle: look only until the reel exists.
  document.querySelectorAll<HTMLButtonElement>('[data-sound]').forEach((b) =>
    b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on));
      b.querySelector('[data-sound-label]')!.textContent = on ? 'Sound on' : 'Muted · tap for sound';
    }),
  );
</script>

<style>
  /* No paper grain or notebook background on this page. */
  :global(body::after) { display: none; }
  :global(body) {
    --bg: #0b0c0d; --surface: #15171a; --ink: #eef0ec; --muted: #8b9096; --line: rgb(238 240 236 / 0.12);
    --accent: #ff3b2f; --ok: #3ddc84;
    --fd: "Doto", monospace; --fb: "Geist Sans", system-ui, sans-serif; --fl: "Geist Mono", ui-monospace, monospace;
    --bar: 40px;
    background: var(--bg); color: var(--ink); font-family: var(--fb);
  }

  /* ---------- Viewfinder frame ---------- */
  .finder { position: fixed; inset: 0; z-index: 40; pointer-events: none; color: var(--ink); }
  .bar {
    position: absolute; left: 0; right: 0; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 8px;
    height: var(--bar); padding: 0 16px; font: 500 12px/1 var(--fl); letter-spacing: 0.06em; text-transform: uppercase;
  }
  .bar > :last-child { justify-self: end; }
  .bar-top {
    top: 0; height: calc(var(--bar) + env(safe-area-inset-top)); padding-top: env(safe-area-inset-top);
    background: linear-gradient(rgb(11 12 13 / 0.95), rgb(11 12 13 / 0.75));
  }
  .bar-bottom {
    bottom: 0; height: calc(var(--bar) + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);
    background: linear-gradient(rgb(11 12 13 / 0.75), rgb(11 12 13 / 0.95));
  }
  .num { font-variant-numeric: tabular-nums; }
  .dim { color: var(--muted); }
  .rec { display: inline-flex; align-items: center; gap: 6px; }
  .rec i { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .corner { position: absolute; width: 18px; height: 18px; border: 0 solid rgb(238 240 236 / 0.7); }
  .c1 { top: calc(var(--bar) + env(safe-area-inset-top) + 6px); left: 8px; border-top-width: 2px; border-left-width: 2px; }
  .c2 { top: calc(var(--bar) + env(safe-area-inset-top) + 6px); right: 8px; border-top-width: 2px; border-right-width: 2px; }
  .c3 { bottom: calc(var(--bar) + env(safe-area-inset-bottom) + 6px); left: 8px; border-bottom-width: 2px; border-left-width: 2px; }
  .c4 { bottom: calc(var(--bar) + env(safe-area-inset-bottom) + 6px); right: 8px; border-bottom-width: 2px; border-right-width: 2px; }
  .center { position: absolute; top: 50%; left: 50%; width: 22px; height: 22px; translate: -50% -50%; opacity: 0.22; }
  .center::before, .center::after { content: ""; position: absolute; background: var(--ink); }
  .center::before { left: 50%; top: 0; bottom: 0; width: 1px; }
  .center::after { top: 50%; left: 0; right: 0; height: 1px; }

  /* ---------- Page ---------- */
  .sg {
    max-width: 60rem; margin: 0 auto;
    padding: calc(var(--bar) + env(safe-area-inset-top) + 40px) 28px calc(var(--bar) + env(safe-area-inset-bottom) + 56px);
  }
  @media (min-width: 1024px) { .sg { padding-left: 48px; padding-right: 48px; } }
  .sg .label { font-family: var(--fl); font-size: 12px; line-height: 1.4; letter-spacing: 0.06em; text-transform: uppercase; }
  .sg .display { font-family: var(--fd); font-weight: 900; text-transform: uppercase; letter-spacing: 0; line-height: 1; }
  .muted { color: var(--muted); }
  .block + .block { margin-top: 56px; }
  .block-label { color: var(--muted); padding-bottom: 10px; margin-bottom: 18px; border-bottom: 1px solid var(--line); }
  .note { margin-top: 12px; font-size: 14px; line-height: 1.5; color: var(--muted); max-width: 52ch; }

  .sg-title { margin-top: 12px; font-size: clamp(44px, 12vw, 88px); }
  .lead { margin-top: 16px; font-size: 18px; line-height: 1.5; color: #c9ccc8; max-width: 44ch; }
  .changes { margin-top: 24px; display: grid; gap: 12px; }
  .changes li { display: grid; grid-template-columns: 5.5rem 1fr; gap: 12px; font-size: 15px; line-height: 1.5; }
  .changes .label { color: var(--ok); padding-top: 2px; }

  /* ---------- Monitor (hero sample) ---------- */
  .monitor {
    position: relative; overflow: hidden; isolation: isolate;
    min-height: min(560px, 72svh); padding: 18px;
    display: flex; flex-direction: column; gap: 10px;
    background: #000; border: 1px solid var(--line);
  }
  @media (min-width: 720px) { .monitor { aspect-ratio: 16 / 9; min-height: 0; padding: 28px; } }
  @media (max-width: 380px) { .sg { padding-left: 20px; padding-right: 20px; } .mon-actions .b { padding: 0 14px; } }
  .footage { position: absolute; inset: 0; z-index: -1; background: radial-gradient(120% 90% at 60% 30%, #2a2d31, #0b0c0d); }
  .footage img { width: 100%; height: 100%; object-fit: cover; filter: saturate(0.85) brightness(0.72); }
  .footage::after {
    content: ""; position: absolute; inset: 0;
    background:
      linear-gradient(rgb(0 0 0 / 0.55), transparent 30%, transparent 45%, rgb(0 0 0 / 0.85)),
      repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.03) 0 1px, transparent 1px 3px);
  }
  .monitor > .lock { inset: 10px; opacity: 0.8; }
  .mon-top { display: flex; justify-content: space-between; align-items: center; }
  .mon-mark { font-size: 20px; }
  .mon-src { color: var(--muted); }
  .mon-bottom { margin-top: auto; display: grid; gap: 12px; }
  .pitch { font-size: clamp(38px, 10.5vw, 72px); }
  .pitch span { display: block; }
  .mon-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .replay { margin-top: 4px; min-height: 44px; color: var(--muted); }
  .replay:hover { color: var(--ink); }

  /* ---------- Readouts ---------- */
  .readouts { display: grid; gap: 0; }
  .readouts li { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .ro-sample { font-variant-numeric: tabular-nums; }
  .ro-what { grid-column: 1 / -1; font-size: 15px; line-height: 1.5; color: #c9ccc8; }

  /* ---------- Colors / type ---------- */
  .swatches { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 12px; }
  @media (min-width: 720px) { .swatches { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .chip { display: block; aspect-ratio: 1.6; border: 1px solid var(--line); border-radius: 2px; }
  .sw-name { display: block; margin-top: 8px; font-size: 15px; font-weight: 600; }
  .sw-meta { display: block; margin-top: 2px; font-size: 11px !important; }
  .type { display: grid; gap: 6px; }
  .t-meta { margin-top: 16px; font-size: 11px !important; }
  .t-meta:first-child { margin-top: 0; }
  .t-display { font-size: 52px; color: var(--accent); }
  .t-h { font-size: 24px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
  .t-body { font-size: 17px; line-height: 1.55; color: #c9ccc8; max-width: 52ch; }
  .t-readout { font-size: 16px !important; }

  /* ---------- Buttons ---------- */
  .btn-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px 12px; align-items: end; }
  .btn-grid .t-meta { margin-bottom: 8px; }
  .b {
    position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 0.5em;
    min-height: 48px; padding: 0 20px; white-space: nowrap; cursor: pointer; border-radius: 2px;
    font: 500 13px/1 var(--fl); letter-spacing: 0.08em; text-transform: uppercase;
    transition: background-color 0.15s, border-color 0.15s, color 0.15s;
  }
  .b-primary { background: var(--accent); color: var(--bg); }
  .b-primary:hover, .b-primary.is-hover { background: #ff5a4f; }
  .b-secondary, .b-sound { border: 1px solid var(--line); color: var(--ink); }
  .b-sound { background: rgb(11 12 13 / 0.6); }
  .b-secondary:hover, .b-secondary.is-hover, .b-sound:hover { border-color: var(--ink); }
  .b-sound[aria-pressed="true"] { border-color: var(--ok); color: var(--ok); }
  .b:active { background-color: var(--ok); color: var(--bg); }

  /* Focus lock: four corners that snap onto a thing, like camera autofocus */
  .lock, .bk { position: absolute; pointer-events: none; }
  .lock i, .bk i { position: absolute; width: 10px; height: 10px; border: 0 solid var(--ink); }
  .lock i:nth-child(1), .bk i:nth-child(1) { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; }
  .lock i:nth-child(2), .bk i:nth-child(2) { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; }
  .lock i:nth-child(3), .bk i:nth-child(3) { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; }
  .lock i:nth-child(4), .bk i:nth-child(4) { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; }
  .bk { inset: -7px; opacity: 0; transition: inset 0.16s steps(2), opacity 0.16s steps(2); }
  .b:hover .bk, .b.is-hover .bk, .b:focus-visible .bk { inset: -5px; opacity: 1; }

  /* ---------- Card ---------- */
  .card { display: block; max-width: 30rem; cursor: pointer; outline-offset: 4px; border: 1px solid var(--line); background: var(--surface); padding: 8px; border-radius: 2px; }
  .card-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #000; }
  .card-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.7) brightness(0.8); transition: filter 0.2s steps(2); }
  .card-media .lock { inset: 22px; opacity: 0.5; transition: inset 0.16s steps(2), opacity 0.16s steps(2); }
  .card-rec { position: absolute; left: 14px; bottom: 12px; display: flex; align-items: center; gap: 6px; font-size: 11px !important; opacity: 0; text-shadow: 0 1px 2px #000; }
  .card-rec b { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .card-body { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 12px 6px 6px; }
  .card-tags { display: flex; align-items: center; gap: 8px; }
  .tag { color: var(--ok); }
  .tag::before { content: "● "; }
  .card-title { margin-top: 6px; font-size: 21px; line-height: 1.15; font-weight: 600; }
  .card-line { margin-top: 4px; font-size: 15px; }
  .card-go { flex: none; display: grid; place-items: center; width: 44px; height: 44px; font-family: var(--fl); border: 1px solid var(--line); border-radius: 2px; }
  .card:hover img, .card.is-on img, .card:focus-visible img { filter: none; }
