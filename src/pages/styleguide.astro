---
// Roadmap 2.1, round 3 (last). Regi: "feel like fishtank.live, no scrolling; on desktop like
// you're on a DSLR's screen, same thing on mobile". The whole window is the camera's live
// view. Every readout means something real and is tappable where that helps.
// Hidden page: not linked anywhere, noindex.
import '@fontsource/doto/latin-900.css';
import '@fontsource/geist-sans/latin-400.css';
import '@fontsource/geist-sans/latin-600.css';
import '@fontsource/geist-mono/latin-400.css';
import '@fontsource/geist-mono/latin-500.css';
import Base from '../layouts/Base.astro';
import { PROFILE, ABOUT, COLLABS, SOCIALS, EMAIL, STATS } from '../config';
import { getWork } from '../lib/work';

const work = await getWork();
const ytId = (m: { platform: string; embed: string }) =>
  m.platform === 'youtube' ? (m.embed.match(/embed\/([\w-]{11})/)?.[1] ?? '') : '';
const items = work.map((w) => ({
  title: w.title,
  type: w.type,
  platform: w.media.platformLabel,
  url: w.url,
  thumb: w.media.thumbnail,
  yt: ytId(w.media),
  note: w.note,
}));
// Footage = every YouTube stream on the site, featured first.
const clips = items.filter((i) => i.yt);
const first = clips[0];
const spotify = SOCIALS.find((s) => s.name === 'Spotify')!.url;
const collabs = COLLABS.map((c) => ({ ...c, clip: clips.findIndex((k) => c.url.includes(k.yt)) }));
const pad2 = (n: number) => String(n).padStart(2, '0');

const swatches = [
  ['Studio', '#0B0C0D'],
  ['Panel', '#15171A'],
  ['Signal', '#EEF0EC'],
  ['Steel', '#8B9096'],
  ['Tally red', '#FF3B2F'],
  ['Preview green', '#3DDC84'],
];
---

<Base title={`Style guide — ${PROFILE.wordmark}`} description="The camera-screen look for regiwock.com." noindex>
  <div class="cam" data-cam>
    <!-- Live view: the stream plays muted behind the readouts -->
    <div class="feed" aria-hidden="true">
      {first?.thumb && <img class="still" src={first.thumb} alt="" data-still onerror="this.hidden=true" />}
      <div class="yt" data-yt></div>
    </div>
    <div class="shade" aria-hidden="true"></div>
    <div class="af" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
    <div class="focus" aria-hidden="true"></div>

    <div class="hud" data-hud>
      <header class="top">
        <a href="#book" class="rec" aria-label="Book me">
          <span class="rec-dot" aria-hidden="true"></span>
          <span>REC</span>
          <span class="rec-book">Book me</span>
        </a>

        <div class="reads">
          <button type="button" class="read" data-open="menu" data-tab="about">
            <small>Creating since</small><b>{STATS.creatingSince}</b>
          </button>
          <a class="read" href={spotify} target="_blank" rel="noopener">
            <small>Monthly listeners</small><b>{STATS.monthlyListeners}</b>
          </a>
          <button type="button" class="read" data-open="menu" data-tab="socials">
            <small>Followers</small><b>{STATS.followers}</b>
          </button>
        </div>

        <p class="clock">
          <b data-time>--:--:--</b>
          <small data-date>&nbsp;</small>
        </p>
      </header>

      <div class="subject">
        <p class="display mark">{PROFILE.wordmark}</p>
        <h1 class="display pitch">{PROFILE.pitch}</h1>
        <p class="label roles">{PROFILE.roles.join(' · ')}</p>
        <a href="#book" class="b b-primary">
          <span class="bk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          ● Book me <span aria-hidden="true">→</span>
        </a>
      </div>

      <footer class="bottom">
        <div class="meter" role="group" aria-label="Footage">
          <div class="meter-row">
            <button type="button" class="key-sq" data-step="-1" aria-label="Previous stream">◀</button>
            <div class="ticks">
              {clips.map((c, i) => (
                <button type="button" class="tick" data-clip={i} aria-label={`Show ${c.title}`} aria-current={i === 0 ? 'true' : undefined}><i></i></button>
              ))}
            </div>
            <button type="button" class="key-sq" data-step="1" aria-label="Next stream">▶</button>
          </div>
          <p class="label now">
            <span class="dim">CAM <span data-cam-n>1</span>/{clips.length}</span> <span data-now>{first?.title}</span>
          </p>
        </div>

        <nav class="keys" aria-label="Camera menu">
          <button type="button" class="key" data-sound aria-pressed="false" hidden>
            <span data-sound-label>Muted</span>
          </button>
          <button type="button" class="key" data-open="menu" data-tab="about">Menu</button>
          <button type="button" class="key key-play" data-open="play">
            ▶ Play <span class="shots">[{pad2(items.length)}]</span>
          </button>
        </nav>
      </footer>
    </div>

    <!-- MENU: camera-menu style panel over the live view -->
    <section class="panel" data-panel="menu" aria-label="Menu" hidden>
      <div class="pbar">
        <button type="button" class="key" data-close>✕ Back</button>
        <span class="label">Menu</span>
        <span class="label dim" data-time>--:--:--</span>
      </div>
      <div class="menu">
        <div class="tabs" role="tablist">
          {['about', 'collabs', 'socials', 'specs'].map((t) => (
            <button type="button" role="tab" class="tab" data-tabbtn={t} aria-selected="false">{t}</button>
          ))}
        </div>

        <div class="tabpanel" data-tabpanel="about" role="tabpanel">
          <h2 class="display ph">About</h2>
          {ABOUT.map((p) => <p class="copy">{p}</p>)}
        </div>

        <div class="tabpanel" data-tabpanel="collabs" role="tabpanel" hidden>
          <h2 class="display ph">Collabs</h2>
          <ul class="collabs">
            {collabs.map((c) => (
              <li>
                <div>
                  <p class="c-name">{c.name}</p>
                  <p class="label c-roles">{c.roles.join(' · ')}</p>
                </div>
                {c.clip >= 0 ? (
                  <button type="button" class="key" data-onscreen={c.clip}>On screen</button>
                ) : (
                  <a class="key" href={c.url} target="_blank" rel="noopener">Watch ↗</a>
                )}
              </li>
            ))}
          </ul>
        </div>

        <div class="tabpanel" data-tabpanel="socials" role="tabpanel" hidden>
          <h2 class="display ph">Socials</h2>
          <ul class="socials">
            {SOCIALS.map((s) => (
              <li><a href={s.url} target="_blank" rel="noopener">{s.name} <span aria-hidden="true">↗</span></a></li>
            ))}
            <li class="wide"><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          </ul>
          <p class="label dim">Followers {STATS.followers} · placeholder until the real counts are in</p>
        </div>

        <div class="tabpanel" data-tabpanel="specs" role="tabpanel" hidden>
          <h2 class="display ph">Specs</h2>
          <ul class="swatches">
            {swatches.map(([n, hex]) => (
              <li><span class="chip" style={`background:${hex}`}></span><span class="label">{n}<br /><span class="dim">{hex}</span></span></li>
            ))}
          </ul>
          <div class="specs-type">
            <p class="display s-display">Book me.</p>
            <p class="s-h">Stream production <span class="label dim">Geist Sans 600</span></p>
            <p class="s-body">Body copy in Geist Sans 400. <span class="label dim">Display: Doto 900 · Labels: Geist Mono</span></p>
          </div>
          <div class="specs-btns">
            <button type="button" class="b b-primary"><span class="bk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>● Book me →</button>
            <button type="button" class="b b-secondary"><span class="bk" aria-hidden="true"><i></i><i></i><i></i><i></i></span>See work</button>
          </div>
        </div>
      </div>
    </section>

    <!-- PLAY: DSLR playback mode, one piece of work at a time -->
    <section class="panel panel-play" data-panel="play" aria-label="Work" hidden>
      <div class="pbar">
        <button type="button" class="key" data-close>✕ Back</button>
        <span class="label">▶ Play</span>
        <span class="label dim"><span data-play-n>1</span>/{items.length}</span>
      </div>
      <div class="viewer" data-viewer>
        <img class="v-img" alt="" data-v-img hidden />
        <p class="display v-tile" data-v-tile></p>
      </div>
      <div class="v-info">
        <div class="v-text">
          <p class="label v-meta"><span class="tag" data-v-type></span> <span class="dim" data-v-platform></span></p>
          <h2 class="v-title" data-v-title></h2>
        </div>
        <div class="v-actions">
          <button type="button" class="key-sq" data-play-step="-1" aria-label="Previous">◀</button>
          <button type="button" class="key" data-v-onscreen hidden>On screen</button>
          <a class="key" data-v-open target="_blank" rel="noopener">Open ↗</a>
          <button type="button" class="key-sq" data-play-step="1" aria-label="Next">▶</button>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/json" id="cam-data" set:html={JSON.stringify({ items, clips })}></script>
</Base>

<script>
  type Item = { title: string; type: string; platform: string; url: string; thumb: string; yt: string; note: string };
  const { items, clips } = JSON.parse(document.getElementById('cam-data')!.textContent!) as { items: Item[]; clips: Item[] };
  const $ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => root.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, root: ParentNode = document) => [...root.querySelectorAll<T>(s)];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');

  // ---- Clock + date: the visitor's real time ----
  const tick = () => {
    const d = new Date();
    const t = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
    $$('[data-time]').forEach((el) => (el.textContent = t));
    $('[data-date]').textContent =
      `${d.toLocaleDateString('en-US', { weekday: 'short' })} ${pad(d.getDate())} ${d.toLocaleDateString('en-US', { month: 'short' })} ${d.getFullYear()}`;
  };
  tick();
  setInterval(tick, 1000);

  // ---- Live view: muted YouTube behind everything ----
  const still = document.querySelector<HTMLImageElement>('[data-still]');
  const ytBox = $('[data-yt]');
  const soundBtn = $<HTMLButtonElement>('[data-sound]');
  let current = 0;
  let soundOn = false;
  let frame: HTMLIFrameElement | null = null;

  const command = (func: string, args: unknown[] = []) =>
    frame?.contentWindow?.postMessage(JSON.stringify({ event: 'command', func, args }), '*');

  const show = (i: number) => {
    current = (i + clips.length) % clips.length;
    const c = clips[current];
    if (still) {
      still.hidden = !c.thumb;
      if (c.thumb) still.src = c.thumb;
    }
    $('[data-now]').textContent = c.title;
    $('[data-cam-n]').textContent = String(current + 1);
    $$('[data-clip]').forEach((t, n) => (n === current ? t.setAttribute('aria-current', 'true') : t.removeAttribute('aria-current')));
    if (reduce) return; // Reduced motion: stills only, nothing autoplays.
    ytBox.replaceChildren();
    ytBox.classList.remove('on');
    const params = new URLSearchParams({
      autoplay: '1', mute: '1', controls: '0', loop: '1', playlist: c.yt, playsinline: '1',
      rel: '0', iv_load_policy: '3', disablekb: '1', modestbranding: '1', enablejsapi: '1', origin: location.origin,
    });
    frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${c.yt}?${params}`;
    frame.allow = 'autoplay; encrypted-media; picture-in-picture';
    frame.tabIndex = -1;
    frame.title = c.title;
    frame.addEventListener('load', () => {
      // Ask the player to report its state so we know when it's really playing.
      frame?.contentWindow?.postMessage(JSON.stringify({ event: 'listening', id: 'feed', channel: 'widget' }), '*');
    });
    ytBox.append(frame);
  };

  addEventListener('message', (e) => {
    if (!/^https:\/\/www\.youtube(-nocookie)?\.com$/.test(e.origin)) return;
    let data: { event?: string; info?: { playerState?: number } | number };
    try { data = JSON.parse(e.data); } catch { return; }
    if (data.event === 'onReady' && soundOn) command('unMute');
    if (data.event === 'infoDelivery' && typeof data.info === 'object' && data.info?.playerState === 1) {
      ytBox.classList.add('on'); // Fade the still out only once video frames are actually showing.
      soundBtn.hidden = false;
    }
    if (data.event === 'onError') ytBox.replaceChildren(); // Not embeddable: the still stays.
  });

  soundBtn.addEventListener('click', () => {
    soundOn = !soundOn;
    soundBtn.setAttribute('aria-pressed', String(soundOn));
    $('[data-sound-label]').textContent = soundOn ? 'Sound on' : 'Muted';
    command(soundOn ? 'unMute' : 'mute');
    if (soundOn) command('setVolume', [70]);
  });
  $$('[data-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.step))));
  $$('[data-clip]').forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.clip))));
  if (clips.length) show(0);

  // ---- Panels (MENU / PLAY) over the live view; no page scroll anywhere ----
  const hud = $('[data-hud]');
  let openPanel: HTMLElement | null = null;
  const close = () => {
    if (!openPanel) return;
    openPanel.hidden = true;
    openPanel = null;
    hud.inert = false;
  };
  const open = (name: string, tab?: string) => {
    close();
    openPanel = $(`[data-panel="${name}"]`);
    openPanel.hidden = false;
    hud.inert = true;
    if (name === 'menu') selectTab(tab || 'about');
    if (name === 'play') showItem(playIndex);
    $<HTMLButtonElement>('[data-close]', openPanel).focus();
  };
  $$('[data-open]').forEach((b) => b.addEventListener('click', () => open(b.dataset.open!, b.dataset.tab)));
  $$('[data-close]').forEach((b) => b.addEventListener('click', close));
  addEventListener('keydown', (e) => {
    if ((document.getElementById('book') as HTMLDialogElement).open) return;
    if (e.key === 'Escape') close();
    if (openPanel?.dataset.panel === 'play' && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) showItem(playIndex + (e.key === 'ArrowLeft' ? -1 : 1));
    if (!openPanel && (e.key === 'ArrowLeft' || e.key === 'ArrowRight')) show(current + (e.key === 'ArrowLeft' ? -1 : 1));
  });

  const selectTab = (t: string) => {
    $$('[data-tabbtn]').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tabbtn === t)));
    $$('[data-tabpanel]').forEach((p) => (p.hidden = p.dataset.tabpanel !== t));
  };
  $$('[data-tabbtn]').forEach((b) => b.addEventListener('click', () => selectTab(b.dataset.tabbtn!)));

  const onScreen = (clip: number) => {
    close();
    show(clip);
  };
  $$('[data-onscreen]').forEach((b) => b.addEventListener('click', () => onScreen(Number(b.dataset.onscreen))));

  // Playback: one item at a time, ◀ ▶ / arrow keys / swipe.
  let playIndex = 0;
  const vImg = $<HTMLImageElement>('[data-v-img]');
  const vTile = $('[data-v-tile]');
  const vOn = $<HTMLButtonElement>('[data-v-onscreen]');
  const showItem = (i: number) => {
    playIndex = (i + items.length) % items.length;
    const it = items[playIndex];
    $('[data-play-n]').textContent = String(playIndex + 1);
    $('[data-v-type]').textContent = it.type;
    $('[data-v-platform]').textContent = it.platform;
    $('[data-v-title]').textContent = it.title;
    $<HTMLAnchorElement>('[data-v-open]').href = it.url;
    vTile.textContent = it.title;
    vImg.hidden = !it.thumb;
    vTile.hidden = !!it.thumb;
    if (it.thumb) vImg.src = it.thumb;
    const clip = clips.findIndex((c) => c.url === it.url);
    vOn.hidden = clip < 0;
    vOn.onclick = () => onScreen(clip);
  };
  vImg.addEventListener('error', () => ((vImg.hidden = true), (vTile.hidden = false)));
  $$('[data-play-step]').forEach((b) => b.addEventListener('click', () => showItem(playIndex + Number(b.dataset.playStep))));
  let x0: number | null = null;
  const viewer = $('[data-viewer]');
  viewer.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
  viewer.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 40) showItem(playIndex + (dx < 0 ? 1 : -1));
    x0 = null;
  });
</script>

<style>
  /* ---- Tokens for this look. Set on :root so the Book me sheet reskins too. ---- */
  :global(:root:root) {
    color-scheme: dark;
    --bg: #0b0c0d; --bg-2: #15171a; --panel: #15171a; --ink: #eef0ec; --muted: #8b9096; --line: rgb(238 240 236 / 0.16);
    --accent: #ff3b2f; --accent-ink: #0b0c0d; --accent-fill: #ff3b2f; --ok: #3ddc84;
    --f-display: "Doto", ui-monospace, monospace; --f-body: "Geist Sans", system-ui, sans-serif;
    --f-mono: "Geist Mono", ui-monospace, monospace; --f-hand: "Geist Mono", ui-monospace, monospace;
  }
  :global(html), :global(body) { height: 100%; overflow: hidden; overscroll-behavior: none; background: #000; }
  :global(body::after) { display: none; }
  :global(dialog.sheet::backdrop) { background: rgb(0 0 0 / 0.6); }

  .cam { position: fixed; inset: 0; overflow: hidden; background: #000; color: var(--ink); font-family: var(--f-body); }
  .label { font-family: var(--f-mono); font-size: 12px; line-height: 1.35; letter-spacing: 0.06em; text-transform: uppercase; }
  .display { font-family: var(--f-display); font-weight: 900; text-transform: uppercase; letter-spacing: 0; line-height: 1; }
  .dim { color: var(--muted); }

  /* ---- Live view ---- */
  .feed { position: absolute; inset: 0; background: radial-gradient(120% 90% at 60% 35%, #2a2d31, #050505); }
  .still, .yt :global(iframe) {
    position: absolute; top: 50%; left: 50%; translate: -50% -50%; border: 0;
    width: max(100vw, 177.78svh); height: max(100svh, 56.25vw);
  }
  .still { object-fit: cover; filter: saturate(0.9) brightness(0.8); }
  /* Oversize the video a little so YouTube's own title/branding falls outside the screen. */
  .yt :global(iframe) { width: calc(max(100vw, 177.78svh) * 1.18); height: calc(max(100svh, 56.25vw) * 1.18); pointer-events: none; }
  .yt { position: absolute; inset: 0; opacity: 0; transition: opacity 0.3s steps(3); }
  .yt.on { opacity: 1; }
  .shade {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(rgb(0 0 0 / 0.7), transparent 24%, transparent 52%, rgb(0 0 0 / 0.85)),
      radial-gradient(120% 100% at 50% 50%, transparent 60%, rgb(0 0 0 / 0.5)),
      repeating-linear-gradient(to bottom, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 3px);
  }
  /* AF area corners + center focus box */
  .af { position: absolute; inset: 14% 8%; pointer-events: none; opacity: 0.55; }
  .af i, .bk i { position: absolute; width: 18px; height: 18px; border: 0 solid var(--ink); }
  .bk i { width: 10px; height: 10px; }
  .af i:nth-child(1), .bk i:nth-child(1) { top: 0; left: 0; border-top-width: 2px; border-left-width: 2px; }
  .af i:nth-child(2), .bk i:nth-child(2) { top: 0; right: 0; border-top-width: 2px; border-right-width: 2px; }
  .af i:nth-child(3), .bk i:nth-child(3) { bottom: 0; left: 0; border-bottom-width: 2px; border-left-width: 2px; }
  .af i:nth-child(4), .bk i:nth-child(4) { bottom: 0; right: 0; border-bottom-width: 2px; border-right-width: 2px; }
  .focus { position: absolute; top: 44%; left: 50%; width: 56px; height: 40px; translate: -50% -50%; border: 1.5px solid rgb(238 240 236 / 0.5); pointer-events: none; }
  .focus::after { content: ""; position: absolute; inset: 50% auto auto 50%; width: 4px; height: 4px; translate: -50% -50%; background: var(--ink); opacity: 0.6; }

  /* ---- HUD: three rows, always exactly one screen ---- */
  .hud {
    position: absolute; inset: 0; display: grid; grid-template-rows: auto 1fr auto; gap: 12px;
    padding: max(12px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) max(12px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left));
    text-shadow: 0 1px 2px rgb(0 0 0 / 0.6);
  }
  .top { display: grid; grid-template-columns: auto 1fr; grid-template-areas: "rec clock" "reads reads"; gap: 10px 12px; align-items: start; }
  .rec { grid-area: rec; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; border: 1px solid rgb(255 59 47 / 0.6); background: rgb(0 0 0 / 0.35); font: 500 13px/1 var(--f-mono); letter-spacing: 0.08em; text-transform: uppercase; }
  .rec-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px var(--accent); }
  .rec-book { color: var(--accent); }
  .rec:hover, .rec:focus-visible { background: var(--accent); color: var(--accent-ink); text-shadow: none; }
  .rec:hover .rec-book, .rec:focus-visible .rec-book { color: var(--accent-ink); }
  .rec:hover .rec-dot, .rec:focus-visible .rec-dot { background: var(--accent-ink); box-shadow: none; }
  .clock { grid-area: clock; justify-self: end; text-align: right; font-family: var(--f-mono); }
  .clock b { display: block; font-size: 20px; font-weight: 500; font-variant-numeric: tabular-nums; }
  .clock small { display: block; margin-top: 2px; font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .reads { grid-area: reads; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
  .read { position: relative; display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start; gap: 3px; min-height: 52px; padding: 6px 8px; text-align: left; border: 1px solid transparent; }
  .read small { font: 500 11px/1.2 var(--f-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  .read b { font: 500 22px/1 var(--f-mono); font-variant-numeric: tabular-nums; }
  .read:hover, .read:focus-visible { border-color: var(--line); background: rgb(0 0 0 / 0.35); }

  .subject { align-self: end; display: grid; justify-items: start; gap: 10px; max-width: min(64rem, 100%); }
  .mark { font-size: 18px; }
  .pitch { font-size: clamp(36px, 10.5vw, 104px); }
  .roles { color: #c9ccc8; }

  .bottom { display: grid; gap: 12px; }
